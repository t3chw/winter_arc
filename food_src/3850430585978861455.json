 "dish": {
  "id": "saunf-jaggery-mint-lassi",
  "name": "Saunf jaggery mint lassi",
  "meal": "Drink",
  "minutes": 5,
  "protein": 10,
  "how": "No cooking",
  "tools": "Mixie (blender), tall glass",
  "serves": 1,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1 tbsp",
    "n": "Fennel seeds (saunf)",
    "tag": "fennel-seeds",
    "img": "i-saunf"
   },
   {
    "q": "~2 tbsp",
    "n": "Jaggery powder (gud)",
    "tag": "jaggery",
    "img": "i-jaggery",
    "alt": [
     "sugar"
    ]
   },
   {
    "q": "~1 tsp, in thin slices",
    "n": "Ginger",
    "tag": "ginger",
    "img": "i-ginger"
   },
   {
    "q": "~10 leaves, plus 1 for the top",
    "n": "Mint leaves",
    "tag": "mint",
    "img": "i-mint"
   },
   {
    "q": "~1 cup (240 g)",
    "n": "Thick curd (dahi)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~1/3 cup",
    "n": "Water",
    "tag": "water",
    "img": "i-water"
   }
  ],
  "steps": [
   {
    "t": "Put the fennel seeds in the mixie jar.",
    "imgs": [
     "s-saunf-1",
     "s-saunf-2"
    ]
   },
   {
    "t": "Add the jaggery powder.",
    "imgs": [
     "s-jaggery-1",
     "s-jaggery-2"
    ]
   },
   {
    "t": "Add the ginger slices.",
    "imgs": [
     "s-ginger-1",
     "s-ginger-2"
    ]
   },
   {
    "t": "Add the mint leaves.",
    "imgs": [
     "s-mint-1",
     "s-mint-2",
     "s-mint-3"
    ]
   },
   {
    "t": "Add the thick curd.",
    "imgs": [
     "s-curd-1",
     "s-curd-2"
    ]
   },
   {
    "t": "Pour in the water.",
    "imgs": [
     "s-water-1",
     "s-water-2"
    ]
   },
   {
    "t": "Cover with the lid and blend until smooth and frothy.",
    "imgs": [
     "s-blend-1",
     "s-blend-2"
    ]
   },
   {
    "t": "Open the lid. The lassi should be thick and creamy.",
    "imgs": [
     "s-open-1",
     "s-open-2"
    ]
   },
   {
    "t": "Pour the lassi into a tall glass.",
    "imgs": [
     "s-pour-1",
     "s-pour-2",
     "s-pour-3"
    ]
   },
   {
    "t": "Top with a fresh mint leaf. Serve cold.",
    "imgs": [
     "s-top-1",
     "s-top-2",
     "s-top-3"
    ]
   }
  ],
  "tags": [
   "blender",
   "no-cook",
   "quick"
  ],
  "credit": "@cocos_chatkara",
  "notes": "Speech was too garbled to read but the ingredients are clear on screen; all amounts are my estimates (nothing is measured on screen). The pale strips are ginger by the speech (saunf, jaggery, ginger, mint). Add ice or chill the curd if you want it cold. Face-cam insets at the top (talking judges) are cropped out of every picture. Near-duplicate of the existing saunf-lassi dish (video 3878025846133512363), which also has almonds, pistachio and rose petals: keep whichever you like."
