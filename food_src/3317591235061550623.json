  ],
  "dish": {
    "id": "no-oil-rajma-chawal",
    "name": "No-oil rajma chawal",
    "meal": "Lunch or dinner",
    "minutes": 50,
    "protein": 15,
    "how": "Pressure cooker",
    "tools": "Pressure cooker, gas, mixie (for tomato puree)",
    "serves": 3,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1 cup (185 g), soaked overnight",
        "n": "Rajma (kidney beans)",
        "tag": "rajma",
        "img": "i-rajma"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "1 to 2 leaves",
        "n": "Bay leaf (tej patta)",
        "tag": "bay-leaf",
        "img": "i-bay"
      },
      {
        "q": "~2 medium",
        "n": "Onion, sliced",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1 inch piece",
        "n": "Ginger, crushed",
        "tag": "ginger",
        "img": "i-paste"
      },
      {
        "q": "~5 cloves",
        "n": "Garlic, crushed",
        "tag": "garlic",
        "img": "i-paste"
      },
      {
        "q": "~2",
        "n": "Green chilli, crushed",
        "tag": "green-chilli",
        "img": "i-paste"
      },
      {
        "q": "~1 1/2 tsp",
        "n": "Salt, in two parts",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/2 tsp",
        "n": "Turmeric (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1 tsp",
        "n": "Coriander powder (dhaniya)",
        "tag": "coriander-powder",
        "img": "i-coriander-powder"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli"
      },
      {
        "q": "~1/2 tsp",
        "n": "Garam masala",
        "tag": "garam-masala",
        "img": "i-garam"
      },
      {
        "q": "~3 medium (about 1 cup puree)",
        "n": "Tomatoes, blended to a puree",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~3 cups (750 ml), plus a splash",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "a handful",
        "n": "Coriander leaves, chopped",
        "tag": "coriander-leaves",
        "opt": true,
        "img": "i-coriander-leaves"
      },
      {
        "q": "~1 cup cooked per person",
        "n": "Cooked rice, to serve",
        "tag": "rice",
        "opt": true,
        "img": "i-rice"
      },
      {
        "q": "a few slices",
        "n": "Raw onion, sliced, to serve",
        "tag": "onion",
        "opt": true,
        "img": "i-onion"
      }
    ],
    "steps": [
      {
        "t": "Put the empty pressure cooker on the stove and heat it.",
        "imgs": [
          "s-heat-1"
        ]
      },
      {
        "t": "Add the bay leaf and cumin seeds. Dry roast for a few seconds, no oil.",
        "imgs": [
          "s-roast-1",
          "s-roast-2",
          "s-roast-3"
        ]
      },
      {
        "t": "Add the sliced onions and stir on medium heat.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Add the crushed ginger, garlic and green chilli.",
        "imgs": [
          "s-paste-1",
          "s-paste-2"
        ]
      },
      {
        "t": "Cook until the onions turn light golden brown.",
        "imgs": [
          "s-golden-1"
        ]
      },
      {
        "t": "Add the salt and turmeric.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Add the coriander powder, red chilli powder and garam masala.",
        "imgs": [
          "s-spice-1",
          "s-spice-2",
          "s-spice-3"
        ]
      },
      {
        "t": "Stir for 1 minute, until the spices smell good.",
        "imgs": [
          "s-fry-1"
        ]
      },
      {
        "t": "Splash in a little water so the masala does not burn. Stir.",
        "imgs": [
          "s-water-1"
        ]
      },
      {
        "t": "Pour in the tomato puree. Cook 4 to 5 minutes until thick.",
        "imgs": [
          "s-puree-1",
          "s-puree-2",
          "s-puree-3"
        ]
      },
      {
        "t": "Add the soaked rajma.",
        "imgs": [
          "s-rajma-1"
        ]
      },
      {
        "t": "Pour in plenty of water and stir. Add the rest of the salt.",
        "imgs": [
          "s-pour-1",
          "s-pour-3"
        ]
      },
      {
        "t": "Close the lid. Pressure cook for 8 to 9 whistles.",
        "imgs": [
          "s-cook-1",
          "s-cook-2"
        ]
      },
      {
        "t": "Let the pressure go down, open the lid and stir. The rajma should be soft.",
        "imgs": [
          "s-open-1",
          "s-open-2"
        ]
      },
      {
        "t": "Sprinkle chopped coriander leaves on top.",
        "imgs": [
          "s-garnish-1"
        ]
      },
      {
        "t": "Serve with rice and sliced raw onion.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "pressure-cooker",
      "one-pot",
      "gas",
      "high-fibre"
    ],
    "notes": "No amounts are shown or spoken in the video, so all amounts are guesses (~). Soaking the rajma overnight is not counted in the minutes. The speech mentions cardamom with the cumin but none is visible, so it is left out. Two beige spice powders (coriander and probably garam masala) look alike, check against the original if you care."
  },
