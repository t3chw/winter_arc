        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1 tsp, plus a pinch for the dressing",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chillipowder"
      },
      {
        "q": "~1/2 tsp",
        "n": "Cumin powder (jeera powder, roasted)",
