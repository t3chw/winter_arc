        "n": "Cashews",
        "tag": "cashews",
        "img": "i-cashews"
      },
      {
        "q": "1 to 2",
        "n": "Dry red chilli",
        "tag": "dry-red-chilli",
        "img": "i-drychilli"
      },
      {
        "q": "3 to 4 cloves",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~50 g, crumbled",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~2 tbsp",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
