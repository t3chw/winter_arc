 "dish": {
  "id": "cheesy-oats-poha-tikki-wrap",
  "name": "Cheesy oats poha tikki wrap",
  "meal": "Lunch or dinner",
  "minutes": 45,
  "protein": 15,
  "how": "Gas",
  "tools": "Frying pan with lid, grill pan, bowl, plate, spatula",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1/2 cup (~40 g)",
    "n": "Poha (flattened rice)",
    "tag": "poha",
    "img": "i-poha"
   },
   {
    "q": "~1/2 cup (~45 g)",
    "n": "Rolled oats",
    "tag": "oats",
    "img": "i-oats"
   },
   {
    "q": "~1/3 cup (~80 ml)",
    "n": "Water",
    "tag": "water",
    "img": "i-water"
   },
   {
    "q": "~3 small (~200 g), boiled",
    "n": "Potatoes (aloo)",
    "tag": "potato",
    "img": "i-potato"
   },
   {
    "q": "~3/4 cup (~120 g), boiled",
    "n": "Sweet corn kernels (1/2 cup for the tikki, a little for the wraps)",
    "tag": "corn",
    "img": "i-corn"
   },
   {
    "q": "~1 small, chopped",
    "n": "Onion (for the tikki)",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~2 tbsp, chopped",
    "n": "Coriander leaves",
    "tag": "coriander-leaves",
    "img": "i-coriander"
   },
   {
    "q": "~1/2 tsp",
    "n": "Brown spice powder (looks like chaat masala or roasted cumin powder)",
    "tag": "chaat-masala",
    "alt": [
     "cumin-powder",
     "garam-masala"
    ],
    "img": "i-spice"
   },
   {
    "q": "~1/2 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli"
   },
   {
    "q": "~1/2 tsp, to taste",
    "n": "Salt",
    "tag": "salt",
    "opt": true
   },
   {
    "q": "~2 tbsp",
    "n": "Corn flour (white powder)",
    "tag": "corn-flour",
    "alt": [
     "rice-flour"
    ],
    "img": "i-cornflour"
   },
   {
    "q": "~3 tbsp, for shallow frying",
    "n": "Oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1/2 cup, grated (~40 g)",
    "n": "Cheese",
    "tag": "cheese",
    "img": "i-cheese"
   },
   {
    "q": "2",
    "n": "Roti (whole wheat chapati)",
    "tag": "atta",
    "img": "i-roti"
   },
   {
    "q": "~2 tbsp",
    "n": "Tomato ketchup",
    "tag": "tomato-ketchup",
    "img": "i-ketchup"
   },
   {
    "q": "~1/2, sliced in rounds",
    "n": "Tomato (for the wraps)",
    "tag": "tomato",
    "img": "i-tomato"
   },
   {
    "q": "~1/2, sliced in thin rings",
    "n": "Onion (for the wraps)",
    "tag": "onion",
    "img": "i-onion2"
   },
   {
    "q": "~1/4, sliced thin",
    "n": "Cucumber",
    "tag": "cucumber",
    "img": "i-cucumber"
   }
  ],
  "steps": [
   {
    "t": "Put the poha in a bowl.",
    "imgs": [
     "s-poha-1"
    ]
   },
   {
    "t": "Add the oats and pour in a little water.",
    "imgs": [
     "s-oats-1",
     "s-oats-2"
    ]
   },
   {
    "t": "Mix until the poha and oats turn soft and sticky.",
    "imgs": [
     "s-soak-1",
     "s-soak-2"
    ]
   },
   {
    "t": "Tip the mix into a wide plate and add the boiled potatoes.",
    "imgs": [
     "s-plate-1",
     "s-plate-2"
    ]
   },
   {
    "t": "Add the sweet corn, chopped onion and coriander.",
    "imgs": [
     "s-veg-1",
     "s-veg-2",
     "s-veg-3"
    ]
   },
   {
    "t": "Add the brown spice powder and the red chilli powder.",
    "imgs": [
     "s-spice-1",
     "s-spice-2",
     "s-spice-3"
    ]
   },
   {
    "t": "Add the corn flour.",
    "imgs": [
     "s-flour-1",
     "s-flour-2"
    ]
   },
   {
    "t": "Mix and mash everything by hand into a soft dough.",
    "imgs": [
     "s-mix-1",
     "s-mix-2"
    ]
   },
   {
    "t": "Shape the dough into flat round tikkis.",
    "imgs": [
     "s-shape-1",
     "s-shape-2"
    ]
   },
   {
    "t": "Heat plenty of oil in a pan and lay the tikkis in it.",
    "imgs": [
     "s-fry-1",
     "s-fry-2"
    ]
   },
   {
    "t": "Fry, spooning oil over them, and flip until golden on both sides.",
    "imgs": [
     "s-fry-3",
     "s-fry-4"
    ]
   },
   {
    "t": "Sprinkle grated cheese on top of each tikki.",
    "imgs": [
     "s-cheese-1",
     "s-cheese-2"
    ]
   },
   {
    "t": "Cover the pan with a lid until the cheese melts.",
    "imgs": [
     "s-lid-1",
     "s-lid-2"
    ]
   },
   {
    "t": "Spread tomato ketchup on a roti.",
    "imgs": [
     "s-roti-1"
    ]
   },
   {
    "t": "Layer on sliced onion, tomato, cucumber and a little sweet corn.",
    "imgs": [
     "s-fill-1"
    ]
   },
   {
    "t": "Place a cheesy tikki on the roti.",
    "imgs": [
     "s-fill-2"
    ]
   },
   {
    "t": "Fold in the sides and roll up tightly.",
    "imgs": [
     "s-roll-1",
     "s-roll-2",
     "s-roll-3"
    ]
   },
   {
    "t": "Heat a grill pan and place the wrap on it.",
    "imgs": [
     "s-grill-1",
     "s-grill-2"
    ]
   },
   {
    "t": "Press with your hand and cook, flipping once, until golden with grill marks.",
    "imgs": [
     "s-press-1",
     "s-press-2",
     "s-press-3"
    ]
   },
   {
    "t": "Lift off the pan and serve hot or pack in a lunchbox.",
    "imgs": [
     "s-serve-1",
     "s-serve-2"
    ]
   }
  ],
  "tags": [
   "gas"
  ],
  "notes": "No amounts, soaking time, frying time or heat levels are shown or readable (speech is garbled), so all quantities are my estimates. The video shows the finished wrap first, then the wrap assembly, then the tikki; I put the tikki first because you need it to make the wrap. Not sure about two powders: brown spice (chaat masala or roasted cumin?) and the white powder (looks like corn flour). Salt is not shown being added; I listed it as optional, taste the mix. The cheese looks like grated mozzarella. A faint round logo sits near the bottom of most frames; I kept the crops above it where possible. Wrap grilling has no oil shown."
 },
