     "s-dip-2"
    ]
   },
   {
    "t": "Heat a little oil in a non-stick pan.",
    "imgs": [
     "s-oil"
    ]
   },
   {
    "t": "Cook the coated slices until golden on both sides.",
    "imgs": [
     "s-fry-1",
     "s-fry-2",
     "s-fry-3"
    ]
   },
