    "img": "i-turmeric"
   },
   {
    "q": "~1/2 tsp",
    "n": "Garam masala (brown powder)",
    "tag": "garam-masala",
    "img": "i-brown"
   },
   {
    "q": "~1/2 tsp",
    "n": "Cumin powder (tan powder)",
    "tag": "cumin-powder",
    "alt": [
     "coriander-powder"
    ],
    "img": "i-tan"
   },
   {
    "q": "~2 tsp, for the tadka and the pan",
    "n": "Oil",
