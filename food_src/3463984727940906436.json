   },
   {
    "q": "~1/2 tsp",
    "n": "Pink salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~1 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli"
   },
   {
    "q": "~1/2 tsp",
    "n": "Turmeric (haldi)",
