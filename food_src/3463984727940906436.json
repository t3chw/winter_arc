    "n": "Curry leaves",
    "tag": "curry-leaves",
    "img": "i-tadka"
   },
   {
    "q": "~1/2 medium",
    "n": "Red onion, sliced thin",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "2 slices",
    "n": "Bread",
    "tag": "bread",
    "img": "i-bread"
   },
   {
    "q": "~2 tbsp",
    "n": "Green chutney (coriander and mint)",
    "tag": "green-chutney",
    "img": "i-chutney"
   },
   {
    "q": "~100 g (4 slabs)",
    "n": "Paneer, cut in thin slabs",
