  "dish": {
    "id": "mango-cashew-kulfi",
    "name": "Mango cashew kulfi",
    "meal": "Snack",
    "minutes": 400,
    "protein": 5,
    "how": "No cooking",
    "tools": "Mixie, kulfi moulds with sticks, knife, freezer",
    "serves": 6,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1/2 cup (~70 g), soaked in water",
        "n": "Green raisins (kishmish)",
        "tag": "raisins",
        "img": "i-raisins"
      },
      {
        "q": "~3/4 cup (~100 g), soaked in water",
        "n": "Cashews (kaju)",
        "tag": "cashews",
        "img": "i-cashews"
      },
      {
        "q": "~2 ripe",
        "n": "Mango",
        "tag": "mango",
        "img": "i-mango"
      },
      {
        "q": "~1 cup (250 ml)",
        "n": "Milk",
        "tag": "milk",
        "img": "i-milk"
      },
      {
        "q": "~2 tbsp",
        "n": "Jaggery syrup (gud syrup)",
        "tag": "jaggery",
        "img": "i-jaggery",
        "alt": [
          "honey"
        ]
      },
      {
        "q": "~1 tbsp",
        "n": "Honey",
        "tag": "honey",
        "img": "i-honey",
        "alt": [
          "jaggery"
        ]
      },
      {
        "q": "~2 tbsp, sliced",
        "n": "Pistachios",
        "tag": "pistachios",
        "img": "i-pistachios",
        "opt": true,
        "alt": [
          "almonds"
        ]
      }
    ],
    "steps": [
      {
        "t": "Put the soaked green raisins (kishmish) into the mixie jar.",
        "imgs": [
          "s-raisin-1",
          "s-raisin-2",
          "s-raisin-3"
        ]
      },
      {
        "t": "Add the soaked cashews along with their soaking water.",
        "imgs": [
          "s-cashew-1",
          "s-cashew-2",
          "s-cashew-3"
        ]
      },
      {
        "t": "Cut the top off the mango.",
        "imgs": [
          "s-top-1",
          "s-top-2"
        ]
      },
      {
        "t": "Cut the mango into two halves.",
        "imgs": [
          "s-half-1",
          "s-half-2"
        ]
      },
      {
        "t": "Score each half in a grid and scoop out the cubes.",
        "imgs": [
          "s-grid-1",
          "s-grid-2"
        ]
      },
      {
        "t": "Add the mango pulp to the jar.",
        "imgs": [
          "s-pulp-1",
          "s-pulp-2"
        ]
      },
      {
        "t": "Pour in the milk.",
        "imgs": [
          "s-milk-1"
        ]
      },
      {
        "t": "Pour in the jaggery syrup.",
        "imgs": [
          "s-syrup-1",
          "s-syrup-2"
        ]
      },
      {
        "t": "Add a thin stream of honey.",
        "imgs": [
          "s-honey-1"
        ]
      },
      {
        "t": "Blend everything until smooth.",
        "imgs": [
          "s-blend-1"
        ]
      },
      {
        "t": "Pour the mix into kulfi moulds.",
        "imgs": [
          "s-pour-1",
          "s-pour-2",
          "s-pour-3"
        ]
      },
      {
        "t": "Spoon a few mango cubes on top of each mould.",
        "imgs": [
          "s-mango-1",
          "s-mango-2"
        ]
      },
      {
        "t": "Sprinkle sliced pistachios on top.",
        "imgs": [
          "s-nuts-1",
          "s-nuts-2"
        ]
      },
      {
        "t": "Put a stick in each mould and freeze until solid, about 6 hours.",
        "imgs": [
          "s-freeze-1"
        ]
      },
      {
        "t": "Pull each kulfi out of its mould by the stick.",
        "imgs": [
          "s-out-1",
          "s-out-2",
          "s-out-3"
        ]
      },
      {
        "t": "Sprinkle sliced pistachios over the kulfi and set it on ice.",
        "imgs": [
          "s-garnish-1",
          "s-garnish-2"
        ]
      },
      {
        "t": "Serve cold.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "no-cook",
      "blender",
      "make-ahead"
    ],
    "credit": "Now I Can Cook",
    "notes": "Silent video (music only), no amounts shown: all quantities are my estimates. The amber liquid looks like jaggery syrup and the thin golden stream like honey (could be another sweetener). Blending, freezing, adding the stick and the final pistachio garnish are not shown; freezing time (about 6 hours) is my estimate and the 400 minutes is about 20 minutes of work plus freezing. The mango is shown cut and scooped, then a bowl of mashed mango pulp goes in. Raisins and cashews are already soaked at the start (soak a few hours ahead)."
  },
