      },
      {
        "q": "2 tsp",
        "n": "Sugar",
        "tag": "sugar",
        "img": "i-sugar"
      },
      {
        "q": "3 small",
        "n": "Potato, boiled",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "1/2 tsp",
        "n": "Chaat masala",
        "tag": "chaat-masala",
        "img": "i-chaat-masala"
      },
      {
        "q": "1/2 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-red-chilli-powder"
      },
      {
        "q": "1/2 tsp",
        "n": "Black salt",
        "tag": "black-salt",
        "img": "i-black-salt"
      },
      {
        "q": "2 big",
        "n": "Green chilli",
        "tag": "green-chilli",
        "img": "i-green-chilli"
      },
      {
        "q": "1 cup",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander-leaves"
      },
      {
        "q": "a few drops",
        "n": "Lemon juice",
        "tag": "lemon",
        "img": "i-lemon"
      },
      {
        "q": "a pinch",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "1 cube",
        "n": "Ice cube",
        "tag": "ice",
        "img": "i-ice"
      },
      {
        "q": "~1/2 tsp",
        "n": "Roasted cumin powder",
        "tag": "cumin-powder",
        "opt": true,
        "img": "i-cumin-powder"
      },
      {
        "q": "~2 tbsp",
        "n": "Sweet chutney (imli or date)",
        "tag": "chutney",
        "opt": true,
        "img": "i-chutney"
      },
      {
        "q": "~4 pieces",
        "n": "Papdi",
        "tag": "papdi",
        "opt": true,
        "img": "i-papdi"
      },
      {
        "q": "~1/4 cup",
        "n": "Nachos, crushed",
        "tag": "nachos",
        "opt": true,
        "img": "i-nachos"
      },
      {
        "q": "~2 tbsp",
        "n": "Pomegranate seeds",
        "tag": "pomegranate",
        "opt": true,
        "img": "i-pomegranate"
      }
    ],
    "steps": [
      {
        "t": "Cut the bread slices into rounds with a steel glass.",
        "imgs": [
          "s1-1",
          "s1-2",
          "s1-3"
        ]
      },
      {
        "t": "Whisk 2 cups curd with 2 tsp sugar.",
        "imgs": [
          "s2-1",
          "s2-2",
          "s2-3"
        ]
      },
      {
        "t": "Strain the curd through a sieve until smooth. Keep it aside.",
        "imgs": [
          "s3-1",
          "s3-2",
          "s3-3"
        ]
      },
      {
        "t": "Put green chilli and 1 cup coriander in a small grinder jar.",
        "imgs": [
          "s4-1",
          "s4-2"
        ]
      },
      {
        "t": "Add salt, lemon juice and an ice cube.",
        "imgs": [
          "s5-1",
          "s5-2",
          "s5-3"
        ]
      },
      {
        "t": "Grind to a smooth green chutney.",
        "imgs": [
          "s6-1",
          "s6-2"
        ]
      },
      {
        "t": "Mash 3 boiled potatoes in a bowl. Add 1/2 tsp chaat masala.",
        "imgs": [
          "s7-1",
          "s7-2"
        ]
      },
      {
        "t": "Add 1/2 tsp red chilli powder and 1/2 tsp black salt.",
        "imgs": [
          "s8-1",
          "s8-2",
          "s8-3"
        ]
      },
      {
        "t": "Add 2 tsp green chutney. Mix into a smooth green filling.",
        "imgs": [
          "s9-1",
          "s9-2",
          "s9-3"
        ]
      },
      {
        "t": "Spread filling on a bread round. Cover with a second round.",
        "imgs": [
          "s10-1",
          "s10-2",
          "s10-3"
        ]
      },
      {
        "t": "Place the sandwiches on a plate.",
        "imgs": [
          "s11-1"
        ]
      },
      {
        "t": "Spoon the sweet curd over them until they are well covered.",
        "imgs": [
          "s12-1",
          "s12-2",
          "s12-3"
        ]
      },
      {
        "t": "Sprinkle roasted cumin powder on top.",
        "imgs": [
          "s13-1",
          "s13-2"
        ]
      },
      {
        "t": "Dot with green chutney. Drizzle sweet chutney.",
        "imgs": [
          "s14-1",
          "s14-2",
          "s14-3"
        ]
      },
      {
        "t": "Top with crushed papdi, nachos and pomegranate seeds. Serve.",
        "imgs": [
          "s15-1",
          "s15-2",
          "s15-3"
        ]
      }
    ],
    "tags": [
      "no-cook",
      "blender",
      "high-protein"
    ],
    "notes": "Amounts for bread, curd, sugar, chutney ingredients and filling are on screen; topping amounts (cumin, sweet chutney, papdi, nachos, pomegranate) are my guesses. Uses boiled potatoes, so boil them beforehand. Sweet chutney was already made (bought or ready). Serves is my guess: 6 slices make about 3 vada."
