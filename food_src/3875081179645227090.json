  "dish": {
    "id": "roti-dough-scissor-noodles",
    "name": "Roti dough scissor noodles",
    "meal": "Lunch or dinner",
    "minutes": 20,
    "protein": 10,
    "how": "Gas",
    "tools": "Pot, pan, scissors, strainer, spatula, gas",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "1 big lump (about 1 cup flour worth)",
        "n": "Leftover roti dough (atta dough)",
        "tag": "atta",
        "img": "i-dough"
      },
      {
        "q": "~4 cups, for boiling",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~1 tbsp",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~100 g, cubed",
        "n": "Tofu",
        "tag": "tofu",
        "img": "i-tofu",
        "alt": [
          "paneer"
        ]
      },
      {
        "q": "1 medium, sliced",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1 tsp",
        "n": "Ginger paste",
        "tag": "ginger",
        "img": "i-ginger"
      },
      {
        "q": "~1 tsp",
        "n": "Garlic paste",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~1 tbsp",
        "n": "Soy sauce",
        "tag": "soy-sauce",
        "img": "i-soy"
      },
      {
        "q": "~1 tbsp",
        "n": "Vinegar",
        "tag": "vinegar",
        "img": "i-vinegar"
      },
      {
        "q": "~1 tbsp",
        "n": "Chilli oil (chilli crisp)",
        "tag": "chilli-oil",
        "img": "i-chilli-oil"
      },
      {
        "q": "~2 big handfuls (60 g)",
        "n": "Spinach leaves",
        "tag": "spinach",
        "img": "i-spinach"
      },
      {
        "q": "~1 tsp",
        "n": "Sesame seeds",
        "tag": "sesame-seeds",
        "img": "i-sesame",
        "opt": true
      }
    ],
    "tags": [
      "gas",
      "quick"
    ],
    "notes": "No amounts are given: all quantities are my estimates. The video's captions say tofu, ginger garlic, soy sauce, vinegar and chilli oil; I matched them to the pictures (the beige lump looks like ginger-garlic paste, the clear liquid like vinegar). Boil time and frying time are not stated (noodles are done when they float). Transferring the pan to the bowl is not shown. The creator speaks to camera but no name is on screen.",
    "steps": [
      {
        "t": "Bring a pot of water to a boil.",
        "imgs": [
          "s-boil-1",
          "s-boil-2"
        ]
      },
      {
        "t": "Hold the dough over the pot. Snip small pieces into the water with scissors.",
        "imgs": [
          "s-cut-1",
          "s-cut-2",
          "s-cut-3"
        ]
      },
      {
        "t": "Stir gently and cook until the pieces float.",
        "imgs": [
          "s-cook-1",
          "s-cook-2"
        ]
      },
      {
        "t": "Lift them out with a strainer and keep aside.",
        "imgs": [
          "s-lift-1",
          "s-lift-2"
        ]
      },
      {
        "t": "Heat oil in a pan.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add the tofu cubes.",
        "imgs": [
          "s-tofu-1",
          "s-tofu-2"
        ]
      },
      {
        "t": "Add the sliced onion and sauté until the tofu turns golden.",
        "imgs": [
          "s-onion-1",
          "s-onion-2",
          "s-onion-3"
        ]
      },
      {
        "t": "Add the ginger and garlic paste.",
        "imgs": [
          "s-gg-1",
          "s-gg-2"
        ]
      },
      {
        "t": "Pour in the soy sauce.",
        "imgs": [
          "s-soy-1",
          "s-soy-2"
        ]
      },
      {
        "t": "Pour in the vinegar.",
        "imgs": [
          "s-vin-1",
          "s-vin-2"
        ]
      },
      {
        "t": "Add the chilli oil and mix.",
        "imgs": [
          "s-crisp-1",
          "s-crisp-2",
          "s-crisp-3"
        ]
      },
      {
        "t": "Add the boiled dough noodles.",
        "imgs": [
          "s-noodle-1",
          "s-noodle-2"
        ]
      },
      {
        "t": "Add the spinach leaves.",
        "imgs": [
          "s-spin-1",
          "s-spin-2",
          "s-spin-3"
        ]
      },
      {
        "t": "Toss everything until the spinach wilts and the noodles are coated.",
        "imgs": [
          "s-toss-1",
          "s-toss-2",
          "s-toss-3"
        ]
      },
      {
        "t": "Spoon it into a bowl and sprinkle sesame seeds on top.",
        "imgs": [
          "s-sesame-1",
          "s-sesame-2",
          "s-sesame-3"
        ]
      },
      {
        "t": "Toss with a fork and eat hot.",
        "imgs": [
          "s-eat-1",
          "s-eat-2"
        ]
      }
    ]
  },
