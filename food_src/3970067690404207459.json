     "s-paneer-1",
     "s-paneer-2"
    ]
   },
   {
    "t": "Cover everything with grated cheese.",
    "imgs": [
     "s-cheesetop-2"
    ]
   },
   {
    "t": "Grind or sprinkle oregano over the top.",
