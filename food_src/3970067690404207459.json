    ]
   },
   {
    "t": "Scatter diced green, yellow and red capsicum on top.",
    "imgs": [
     "s-capsicum-1",
     "s-capsicum-2"
    ]
   },
   {
    "t": "Add the boiled sweet corn.",
    "imgs": [
     "s-corn-2"
    ]
   },
   {
    "t": "Add the red onion pieces.",
    "imgs": [
     "s-onion-2"
    ]
   },
   {
    "t": "Add the paneer cubes.",
