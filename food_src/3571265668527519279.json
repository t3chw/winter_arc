  "dish": {
    "id": "dahi-capsicum-sabzi",
    "name": "Dahi capsicum sabzi",
    "meal": "Lunch or dinner",
    "minutes": 20,
    "protein": 5,
    "how": "Gas",
    "tools": "Non-stick pan, gas, mortar (or grater)",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "1 large (~150 g)",
        "n": "Green capsicum",
        "tag": "capsicum",
        "img": "i-capsicum"
      },
      {
        "q": "1 medium",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~2 tbsp, in all",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp, crushed",
        "n": "Kasuri methi (dry fenugreek leaves)",
        "tag": "kasuri-methi",
        "img": "i-kasuri"
      },
      {
        "q": "a small handful, chopped",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "~1 tsp, plus ~1 tsp later",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chillipowder"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~1 tsp",
        "n": "Sesame seeds",
        "tag": "sesame-seeds",
        "img": "i-sesame"
      },
      {
        "q": "~8 leaves",
        "n": "Curry leaves",
        "tag": "curry-leaves",
        "img": "i-curryleaves"
      },
      {
        "q": "4 to 5 cloves, crushed",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~1/2 tsp, to taste",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/4 tsp",
        "n": "Turmeric",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1/2 tsp",
        "n": "Garam masala",
        "tag": "garam-masala",
        "img": "i-garammasala"
      },
      {
        "q": "~2 tbsp, crushed",
        "n": "Peanuts",
        "tag": "peanuts",
        "img": "i-peanuts"
      },
      {
        "q": "~1/2 cup (100 g)",
        "n": "Thick curd (dahi), whisked",
        "tag": "curd",
        "img": "i-curd"
      }
    ],
    "steps": [
      {
        "t": "Cut the capsicum into long slices.",
        "imgs": [
          "s-cut-1",
          "s-cut-2"
        ]
      },
      {
        "t": "Slice the onion into long slices too.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Heat oil in a non-stick pan. Add the sliced onion and sauté.",
        "imgs": [
          "s-saute-1",
          "s-saute-2"
        ]
      },
      {
        "t": "Add the capsicum slices and stir.",
        "imgs": [
          "s-caps-1",
          "s-caps-2"
        ]
      },
      {
        "t": "Add crushed kasuri methi and chopped coriander.",
        "imgs": [
          "s-herb-1",
          "s-herb-2",
          "s-herb-3"
        ]
      },
      {
        "t": "Add red chilli powder. Cook, stirring, until the capsicum is soft.",
        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Move the cooked capsicum to a plate.",
        "imgs": [
          "s-plate-1",
          "s-plate-2"
        ]
      },
      {
        "t": "In the same pan, heat a little oil. Add cumin seeds.",
        "imgs": [
          "s-cumin-1",
          "s-cumin-2"
        ]
      },
      {
        "t": "Add sesame seeds.",
        "imgs": [
          "s-sesame-1",
          "s-sesame-2"
        ]
      },
      {
        "t": "Add curry leaves.",
        "imgs": [
          "s-curry-1"
        ]
      },
      {
        "t": "Crush the garlic and add it to the pan.",
        "imgs": [
          "s-garlic-1",
          "s-garlic-2",
          "s-garlic-3"
        ]
      },
      {
        "t": "Put the cooked capsicum back in the pan.",
        "imgs": [
          "s-back-1",
          "s-back-2"
        ]
      },
      {
        "t": "Add salt and turmeric.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Add garam masala and a little more red chilli powder.",
        "imgs": [
          "s-masala-1",
          "s-masala-2",
          "s-masala-3"
        ]
      },
      {
        "t": "Crush the peanuts and add them.",
        "imgs": [
          "s-peanut-1",
          "s-peanut-2",
          "s-peanut-3"
        ]
      },
      {
        "t": "Whisk the curd until smooth.",
        "imgs": [
          "s-curd-1"
        ]
      },
      {
        "t": "Add the curd and mix well until combined.",
        "imgs": [
          "s-mixcurd-1",
          "s-mixcurd-2",
          "s-mixcurd-3"
        ]
      },
      {
        "t": "Serve hot in a bowl, with paratha or roti.",
        "imgs": [
          "s-serve-1"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "notes": "No amounts are given in the video, so all quantities are estimates. Cooking times and heat levels are not shown; keep the heat low when adding curd so it does not split. Peanuts are crushed raw in a mortar (roasted peanuts would also work). The paratha in the last shot is only for serving."
  },
