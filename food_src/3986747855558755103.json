   },
   {
    "q": "~1 small, finely chopped",
    "n": "Onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~2, finely chopped",
    "n": "Green chilli",
    "tag": "green-chilli",
    "img": "i-gchilli"
   },
   {
    "q": "~3 tbsp, chopped",
    "n": "Coriander leaves",
    "tag": "coriander-leaves",
    "img": "i-coriander"
   },
   {
    "q": "~1/4 tsp",
    "n": "Turmeric powder",
    "tag": "turmeric",
    "img": "i-turmeric"
   },
   {
    "q": "~1/2 tsp, to taste",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~5 slices",
    "n": "White bread",
    "tag": "bread",
    "img": "i-bread"
   },
   {
    "q": "~1/2 cup (50 g)",
    "n": "Bread crumbs",
