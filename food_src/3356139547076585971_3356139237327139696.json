  "dish": {
    "id": "paneer-corn-spinach-sandwich",
    "name": "Paneer corn spinach sandwich",
    "meal": "Breakfast",
    "minutes": 20,
    "protein": 30,
    "how": "Gas",
    "tools": "Pan, tawa (flat griddle), gas, spatula",
    "serves": 1,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1 tbsp, plus a little for the tawa",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1/2 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~4 cloves, chopped",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~2, chopped",
        "n": "Green chilli",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "~1/2 tsp",
        "n": "Chilli flakes",
        "tag": "chilli-flakes",
        "img": "i-flakes"
      },
      {
        "q": "~1 cup, loosely packed",
        "n": "Spinach, chopped (the leaves look like lettuce, either works)",
        "tag": "spinach",
        "img": "i-spinach",
        "alt": [
          "lettuce"
        ]
      },
      {
        "q": "~1/4 cup",
        "n": "Sweet corn kernels",
        "tag": "corn",
        "img": "i-corn"
      },
      {
        "q": "~100 g, grated",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~1/4 tsp",
        "n": "Salt",
        "tag": "salt"
      },
      {
        "q": "3 slices",
        "n": "Bread",
        "tag": "bread",
        "img": "i-bread"
      },
      {
        "q": "~2 tbsp",
        "n": "Green chutney (mint-coriander)",
        "tag": "green-chutney",
        "img": "i-chutney"
      },
      {
        "q": "~2 tbsp",
        "n": "White spread (looks like cheese spread or thick curd)",
        "tag": "cheese",
        "alt": [
          "curd"
        ],
        "opt": true,
        "img": "i-spread"
      },
      {
        "q": "a few rings",
        "n": "Onion, sliced in rings",
        "tag": "onion",
        "opt": true,
        "img": "i-onion"
      },
      {
        "q": "2 slices",
        "n": "Tomato, sliced",
        "tag": "tomato",
        "opt": true,
        "img": "i-tomato"
      }
    ],
    "steps": [
      {
        "t": "Heat the oil in a pan.",
        "imgs": [
          "s-oil-1"
        ]
      },
      {
        "t": "Add the cumin seeds.",
        "imgs": [
          "s-cumin-1"
        ]
      },
      {
        "t": "Add the chopped garlic and green chilli.",
        "imgs": [
          "s-garlic-1",
          "s-garlic-2"
        ]
      },
      {
        "t": "Add the chilli flakes and stir for a few seconds.",
        "imgs": [
          "s-flakes-1",
          "s-flakes-2"
        ]
      },
      {
        "t": "Add the spinach.",
        "imgs": [
          "s-spinach-1"
        ]
      },
      {
        "t": "Add the sweet corn.",
        "imgs": [
          "s-corn-1"
        ]
      },
      {
        "t": "Add the grated paneer and the salt.",
        "imgs": [
          "s-paneer-1",
          "s-paneer-2"
        ]
      },
      {
        "t": "Mix well on medium heat. The stuffing is ready.",
        "imgs": [
          "s-mix-1",
          "s-mix-2"
        ]
      },
      {
        "t": "Put a bread slice on a plate.",
        "imgs": [
          "s-bread-1"
        ]
      },
      {
        "t": "Spread green chutney on the bread.",
        "imgs": [
          "s-chutney-1"
        ]
      },
      {
        "t": "Spoon the paneer stuffing on top.",
        "imgs": [
          "s-fill-1",
          "s-fill-2"
        ]
      },
      {
        "t": "Cover with a second bread slice.",
        "imgs": [
          "s-bread-2"
        ]
      },
      {
        "t": "Spread the white spread on the second slice.",
        "imgs": [
          "s-spread-1"
        ]
      },
      {
        "t": "Add more stuffing on top.",
        "imgs": [
          "s-fill-3",
          "s-fill-4"
        ]
      },
      {
        "t": "Add an onion ring and a tomato slice.",
        "imgs": [
          "s-veg-1",
          "s-veg-2"
        ]
      },
      {
        "t": "Close with the third bread slice.",
        "imgs": [
          "s-top-1"
        ]
      },
      {
        "t": "Heat a tawa and brush it with oil.",
        "imgs": [
          "s-tawa-1"
        ]
      },
      {
        "t": "Place the sandwich on the tawa.",
        "imgs": [
          "s-tawa-2"
        ]
      },
      {
        "t": "Cook on both sides until golden and crisp. Press with a spatula.",
        "imgs": [
          "s-cook-1",
          "s-cook-2",
          "s-cook-3"
        ]
      },
      {
        "t": "Cut into triangles and serve with green chutney.",
        "imgs": [
          "s-serve-1"
        ]
      }
    ],
    "tags": [
      "gas",
      "high-protein"
    ],
    "notes": "No speech and no amounts in the video, all amounts are guesses (~). The white spread on the second layer is not named: it could be mayonnaise (many contain egg, avoid) so use cheese spread or thick hung curd. Chutney recipe is not shown. The leaf may look like lettuce but the on-screen text says spinach. Quick tag is not used since time is about 20 minutes."
