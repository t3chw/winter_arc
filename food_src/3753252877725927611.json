     "s-salt-2"
    ]
   },
   {
    "t": "Cover and boil the potatoes until a knife goes in easily.",
    "imgs": [
     "s-boil-1",
     "s-boil-2",
     "s-boil-3"
    ]
   },
   {
    "t": "Drain the potatoes in a sieve.",
    "imgs": [
     "s-drain-1"
    ]
   },
