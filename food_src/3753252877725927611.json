 "dish": {
  "id": "smashed-potatoes-paneer-sauce",
  "name": "Smashed potatoes with paneer sauce",
  "meal": "Snack",
  "minutes": 50,
  "protein": 20,
  "how": "Gas",
  "tools": "Pan with lid, tawa, mixie (blender) jar, sieve, steel bowl, spoon, spatula",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~500 g (about 20 baby potatoes)",
    "n": "Baby potatoes",
    "tag": "potato",
    "img": "i-potato"
   },
   {
    "q": "enough to cover the potatoes",
    "n": "Water, for boiling",
    "tag": "water",
    "img": "i-water"
   },
   {
    "q": "~1 tsp in all (boiling water, sauce and batter)",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~120 g (about 12 cubes)",
    "n": "Paneer, in cubes",
    "tag": "paneer",
    "img": "i-paneer"
   },
   {
    "q": "~3 tbsp",
    "n": "Curd (dahi)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~5 cloves",
    "n": "Garlic",
    "tag": "garlic",
    "img": "i-garlic"
   },
   {
    "q": "~1 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli"
   },
   {
    "q": "~2 tbsp",
    "n": "Rice flour (chawal ka atta)",
    "tag": "rice-flour",
    "img": "i-riceflour"
   },
   {
    "q": "~2 tbsp",
    "n": "Corn flour",
    "tag": "corn-flour",
    "img": "i-cornflour"
   },
   {
    "q": "~1/4 cup, for the batter",
    "n": "Water, for the batter",
    "tag": "water",
    "img": "i-batterwater"
   },
   {
    "q": "~1 tbsp, very little",
    "n": "Oil, for the pan",
    "tag": "oil",
    "alt": [
     "ghee"
    ]
   },
   {
    "q": "~2 tbsp",
    "n": "Red onion, finely chopped",
    "tag": "onion",
    "img": "i-onion",
    "opt": true
   },
   {
    "q": "a small handful",
    "n": "Coriander leaves, chopped",
    "tag": "coriander-leaves",
    "img": "i-coriander",
    "opt": true
   },
   {
    "q": "a pinch",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "img": "i-flakes",
    "opt": true
   }
  ],
  "steps": [
   {
