  "dish": {
    "id": "creamy-zoodles-spicy-paneer",
    "name": "Zucchini noodles with spicy paneer",
    "meal": "Lunch or dinner",
    "minutes": 35,
    "protein": 30,
    "how": "Gas",
    "tools": "Wok or pan, gas, blender, julienne peeler",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      { "q": "1 large (~300 g)", "n": "Zucchini", "tag": "zucchini", "img": "i-zucchini" },
      { "q": "~150 g", "n": "Paneer, cut in cubes", "tag": "paneer", "img": "i-paneer" },
      { "q": "~2 tsp", "n": "Chilli flakes", "tag": "chilli-flakes", "img": "i-chilliflakes" },
      { "q": "~2 tbsp", "n": "Coriander leaves, chopped", "tag": "coriander-leaves", "img": "i-coriander" },
      { "q": "~1/2 tsp", "n": "Black pepper", "tag": "black-pepper", "img": "i-pepper" },
      { "q": "to taste", "n": "Salt", "tag": "salt", "img": "i-salt" },
      { "q": "~3 tbsp", "n": "Oil", "tag": "oil", "img": "i-oil" },
      { "q": "~1 cup (3 colours)", "n": "Capsicum, red, yellow and green, cut in pieces", "tag": "capsicum", "img": "i-capsicum" },
      { "q": "1", "n": "Dry red chilli", "tag": "dry-red-chilli", "img": "i-drychilli" },
      { "q": "~1 tbsp", "n": "Garlic, grated", "tag": "garlic", "img": "i-garlic" },
      { "q": "1 medium", "n": "Onion, cut in petals", "tag": "onion", "img": "i-onion" },
      { "q": "2 medium (~1 cup chopped)", "n": "Tomato, chopped", "tag": "tomato", "img": "i-tomato" },
      { "q": "~1/2 tsp", "n": "Turmeric", "tag": "turmeric", "img": "i-turmeric" },
      { "q": "~1 tsp", "n": "Red chilli powder", "tag": "red-chilli-powder", "img": "i-chillipowder" },
      { "q": "~1/2 cup (100 g)", "n": "Red lentils (masoor dal)", "tag": "masoor-dal", "img": "i-dal", "alt": ["moong-dal"] },
      { "q": "~10", "n": "Cashews", "tag": "cashews", "img": "i-cashews" },
      { "q": "~2 cups", "n": "Water", "tag": "water", "img": "i-water" },
      { "q": "a pinch", "n": "Sesame seeds", "tag": "sesame-seeds", "img": "i-sesame", "opt": true }
    ],
    "steps": [
      { "t": "Peel the zucchini into long thin noodles with a julienne peeler. Keep the leftover centre.", "imgs": ["s-peel-1", "s-peel-2", "s-peel-3"] },
      { "t": "Sauce: heat 1 tbsp oil in a pan. Add dry red chilli and grated garlic.", "imgs": ["s-sauce-1", "s-sauce-1b"] },
      { "t": "Add the onion and tomato. Cook on medium heat until the tomato softens.", "imgs": ["s-sauce-2", "s-sauce-3"] },
      { "t": "Add turmeric and red chilli powder. Mix well.", "imgs": ["s-sauce-4", "s-sauce-5"] },
      { "t": "Add the red lentils and cashews.", "imgs": ["s-sauce-6", "s-sauce-7"] },
      { "t": "Pour in water, cover with a lid and cook until the lentils are soft and mushy.", "imgs": ["s-sauce-8", "s-sauce-9", "s-sauce-10"] },
      { "t": "Move to a blender jar. Add the leftover zucchini pieces and a little water.", "imgs": ["s-blend-1", "s-blend-2"] },
      { "t": "Blend until smooth.", "imgs": ["s-blend-3"] },
      { "t": "Pour the sauce back into the pan. Add salt and pepper and stir. Keep it warm.", "imgs": ["s-sauce-11", "s-sauce-12", "s-sauce-13"] },
      { "t": "Heat a wok with a little oil. Fry the paneer cubes until golden.", "imgs": ["s-paneer-1", "s-paneer-2"] },
      { "t": "Add the capsicum and stir fry on high heat for 1 to 2 minutes.", "imgs": ["s-paneer-3", "s-paneer-4"] },
      { "t": "In a clean wok, heat oil. Add chilli flakes and salt.", "imgs": ["s-noodle-1", "s-noodle-2"] },
      { "t": "Add the zucchini noodles and toss with tongs for about 1 minute.", "imgs": ["s-noodle-3", "s-noodle-4"] },
      { "t": "In a bowl, add the paneer and capsicum, then the noodles. Pour the sauce beside them.", "imgs": ["s-plate-1", "s-plate-2", "s-plate-3"] }
    ],
    "tags": ["gas", "blender", "high-protein"],
    "notes": "Silent video, no text, so every amount is a guess. Not shown: how the paneer was coated (chilli flakes, coriander, pepper) and the lentil cooking time (~10 min guessed). Pale pieces blended into the sauce look like the leftover zucchini centre. Steps are re-ordered so the sauce is made first."
