   },
   {
    "q": "~3 medium, pureed",
    "n": "Tomato",
    "tag": "tomato",
    "img": "i-tomato"
   },
   {
    "q": "~1 tbsp",
    "n": "Dried fenugreek leaves (kasuri methi)",
    "tag": "kasuri-methi",
    "img": "i-kasuri"
   },
