    "img": "i-drychilli"
   },
   {
    "q": "~2 medium, crushed",
    "n": "Onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~3, chopped",
    "n": "Green chilli",
    "tag": "green-chilli",
    "img": "i-greenchilli"
   },
   {
    "q": "~1.5 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli-powder"
   },
   {
    "q": "~1/2 tsp",
    "n": "Turmeric (haldi)",
    "tag": "turmeric",
    "img": "i-turmeric"
   },
   {
    "q": "~1 tbsp",
    "n": "Coriander powder (dhania)",
