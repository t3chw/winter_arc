    "n": "Garlic",
    "tag": "garlic",
    "img": "i-garlic"
   },
   {
    "q": "~1 tsp",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "img": "i-chilli"
   },
   {
    "q": "~1/4 tsp",
    "n": "Pink salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~2 tbsp, hot",
    "n": "Olive oil",
