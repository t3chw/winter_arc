 "dish": {
  "id": "strawberry-chia-curd-pudding",
  "name": "Strawberry chia curd pudding",
  "meal": "Breakfast",
  "minutes": 10,
  "protein": 10,
  "how": "No cooking",
  "tools": "Bowl, spoon, fridge",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1 cup (~250 g)",
    "n": "Curd (dahi)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~2 tbsp dry seeds, already soaked in water",
    "n": "Chia seeds, soaked",
    "tag": "chia-seeds",
    "img": "i-chia"
   },
   {
    "q": "~1 tbsp",
    "n": "Honey",
    "tag": "honey",
    "img": "i-honey"
   },
   {
    "q": "~1 cup, chopped (~150 g)",
    "n": "Strawberries",
    "tag": "berries",
    "img": "i-strawberry"
   },
   {
    "q": "~1 tbsp",
    "n": "Almonds, sliced (badam)",
    "tag": "almonds",
    "img": "i-almond"
   },
   {
    "q": "~1 tbsp",
    "n": "Pumpkin seeds",
    "tag": "pumpkin-seeds",
    "img": "i-pumpkin"
   },
   {
    "q": "~4, chopped",
    "n": "Dates (khajoor)",
    "tag": "dates",
    "img": "i-dates"
   },
   {
    "q": "~1 tbsp",
    "n": "Raisins (kishmish)",
    "tag": "raisins",
    "img": "i-raisins"
   },
   {
    "q": "a few, chopped",
    "n": "Walnuts (akhrot), for the top",
    "tag": "walnuts",
    "img": "i-walnut",
    "opt": true
   },
   {
    "q": "a few",
    "n": "Pistachios, for the top",
    "tag": "pistachios",
    "img": "i-pistachio",
    "opt": true
   }
  ],
  "steps": [
   {
    "t": "Pour the curd into a large bowl.",
    "imgs": [
     "s-curd-1",
     "s-curd-2"
    ]
   },
   {
    "t": "Add the soaked chia seeds.",
    "imgs": [
     "s-chia-1",
     "s-chia-2"
    ]
   },
   {
    "t": "Drizzle honey over the chia seeds.",
    "imgs": [
     "s-honey-1",
     "s-honey-2"
    ]
   },
   {
    "t": "Mix well until the chia and curd are smooth and creamy.",
    "imgs": [
     "s-mix-1",
     "s-mix-2"
    ]
   },
   {
    "t": "Add the chopped strawberries.",
    "imgs": [
     "s-straw-1",
     "s-straw-2"
    ]
   },
   {
    "t": "Add the sliced almonds and pumpkin seeds.",
    "imgs": [
     "s-nuts-1",
     "s-nuts-2"
    ]
   },
   {
    "t": "Add the chopped dates.",
    "imgs": [
     "s-dates-1"
    ]
   },
   {
    "t": "Add the raisins.",
    "imgs": [
     "s-raisin-1",
     "s-raisin-2"
    ]
   },
   {
    "t": "Mix everything well until the pudding turns light pink.",
    "imgs": [
     "s-stir-1",
     "s-stir-2"
    ]
   },
   {
    "t": "Refrigerate for 1 to 2 hours to set.",
    "imgs": [
     "s-chill-1"
    ]
   },
   {
    "t": "Top with strawberries, nuts and raisins. Serve chilled.",
    "imgs": [
     "s-top-1"
    ]
   }
  ],
  "tags": [
   "no-cook",
   "high-fibre"
  ],
  "credit": "@Mumbaifoodiz",
  "notes": "No amounts are shown or said, all quantities are my estimates. Chia soaking time is not shown (video starts with chia already soaked). The 'refrigerate' text appears while mixing, so I put chilling after mixing, then topping; the video does not show the topping step separately (the last shot just shows the finished bowl with fruit, nuts and raisins on top). 10 min does not include the 1-2 h chill. Protein is about 10 g per serving, so not high-protein. Faint creator watermark sits on the bowl in most frames and cannot be cropped out."
