  "dish": {
    "id": "soya-paneer-veg-tehri",
    "name": "Soya paneer veg tehri",
    "meal": "Lunch or dinner",
    "minutes": 30,
    "protein": 30,
    "how": "Pressure cooker",
    "tools": "Pressure cooker, gas",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1 cup (180 g)",
        "n": "Basmati rice, washed and soaked 15 to 20 min",
        "tag": "rice",
        "img": "i-rice"
      },
      {
        "q": "~1 tbsp",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp",
        "n": "Ghee (desi ghee)",
        "tag": "ghee",
        "img": "i-ghee"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "1 small piece each",
        "n": "Whole spices (cinnamon, star anise, cardamom)",
        "tag": "whole-spices",
        "img": "i-wholespice"
      },
      {
        "q": "~1 large (150 g)",
        "n": "Onion, sliced",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-redchilli"
      },
      {
        "q": "~1/2 tsp",
        "n": "Turmeric powder (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1 tsp",
        "n": "Coriander powder (dhaniya powder)",
        "tag": "coriander-powder",
        "img": "i-corpowder"
      },
      {
        "q": "~1/2 tsp",
        "n": "Garam masala",
        "tag": "garam-masala"
      },
      {
        "q": "~2",
        "n": "Green chillies, chopped",
        "tag": "green-chilli",
        "img": "i-greenchilli"
      },
      {
        "q": "~2 medium (200 g)",
        "n": "Potato, sliced",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~2 medium",
        "n": "Tomato, cut in wedges",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1/2 (50 g)",
        "n": "Red capsicum, sliced",
        "tag": "capsicum",
        "img": "i-capsicum",
        "alt": [
          "mixed-vegetables"
        ]
      },
      {
        "q": "~1.5 cups (150 g)",
        "n": "Cauliflower florets",
        "tag": "cauliflower",
        "img": "i-cauli",
        "alt": [
          "mixed-vegetables"
        ]
      },
      {
        "q": "~1/2 cup (30 g) dry",
        "n": "Soya chunks (small), soaked in hot water and squeezed",
        "tag": "soya-chunks",
        "img": "i-soya"
      },
      {
        "q": "~1/2 cup (70 g)",
        "n": "Green peas",
        "tag": "peas",
        "img": "i-peas",
        "alt": [
          "mixed-vegetables"
        ]
      },
      {
        "q": "~1.5 cups (300 ml)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~100 g (about 12 cubes)",
        "n": "Paneer, cubed and pan-fried until golden",
        "tag": "paneer",
        "img": "i-paneer",
        "alt": [
          "tofu"
        ]
      },
      {
        "q": "a handful",
        "n": "Coriander leaves (dhania), chopped",
        "tag": "coriander-leaves",
        "img": "i-coriander",
        "opt": true
      }
    ],
    "steps": [
      {
        "t": "Wash the rice in water, then leave it to soak for 15 to 20 minutes.",
        "imgs": [
          "s-rice-1",
          "s-rice-2",
          "s-rice-3"
        ]
      },
      {
        "t": "Add the oil and ghee to the pressure cooker and let them heat.",
        "imgs": [
          "s-heat-1",
          "s-heat-2"
        ]
      },
      {
        "t": "Add the cumin seeds and whole spices to the hot oil.",
        "imgs": [
          "s-spice-1",
          "s-spice-2"
        ]
      },
      {
        "t": "Add the sliced onion and sauté until soft.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Add salt, red chilli powder, turmeric, coriander powder and garam masala. Stir well.",
        "imgs": [
          "s-masala-1",
          "s-masala-2",
          "s-masala-3"
        ]
      },
      {
        "t": "Add the chopped green chilli, then the potato slices.",
        "imgs": [
          "s-potato-1",
          "s-potato-2"
        ]
      },
      {
        "t": "Add the tomato wedges and red capsicum.",
        "imgs": [
          "s-tomato-1",
          "s-tomato-2"
        ]
      },
      {
        "t": "Add the cauliflower, soaked soya chunks and green peas.",
        "imgs": [
          "s-veg-1",
          "s-veg-2",
          "s-veg-3"
        ]
      },
      {
        "t": "Stir everything well and sauté for 2 to 3 minutes.",
        "imgs": [
          "s-saute-1",
          "s-saute-2"
        ]
      },
      {
        "t": "Add the soaked rice to the cooker.",
        "imgs": [
          "s-ricein-1",
          "s-ricein-2"
        ]
      },
      {
        "t": "Pour in the water and stir.",
        "imgs": [
          "s-water-1",
          "s-water-2"
        ]
      },
      {
        "t": "Close the lid and cook until the first whistle.",
        "imgs": [
          "s-cook-1"
        ]
      },
      {
        "t": "Switch off the gas and leave the lid closed for 5 minutes.",
        "imgs": [
          "s-rest-1"
        ]
      },
      {
        "t": "Open the lid. The rice should be cooked and the water absorbed.",
        "imgs": [
          "s-open-1",
          "s-open-2"
        ]
      },
      {
        "t": "Add the fried paneer cubes and chopped coriander on top.",
        "imgs": [
          "s-paneer-1",
          "s-paneer-2"
        ]
      },
      {
        "t": "Mix gently and serve hot, with raita and green chutney if you like.",
        "imgs": [
          "s-mix-1",
          "s-mix-2"
        ]
      }
    ],
    "tags": [
      "pressure-cooker",
      "one-pot",
      "high-protein",
      "high-fibre"
    ],
    "notes": "No amounts shown or spoken, so all quantities are guesses from the bowls and pot (rice ~1 cup, water ~1.5 cups). Needs a 15-20 min rice soak (about 10 min of actual cooking). Narration is garbled on the 5-min rest after the whistle: I read it as gas off and steam finishes the rice. Garam masala is spoken but not clearly shown (no thumbnail); the brown powder on screen is used as coriander powder. Soya and paneer appear already soaked and fried (not shown): soak soya in hot water and squeeze, shallow-fry paneer cubes. Raita and green chutney in the plated shot are not made in the video."
  },
