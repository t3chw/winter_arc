        "alt": [
          "masoor-dal"
        ]
      },
      {
        "q": "~2 handfuls (~60 g)",
        "n": "Spinach (palak)",
        "tag": "spinach",
        "img": "i-spinach"
      },
      {
        "q": "~1 handful",
        "n": "Coriander leaves (dhania)",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "~1 inch piece",
        "n": "Ginger (adrak)",
        "tag": "ginger",
        "img": "i-gingerchilli"
      },
      {
        "q": "~2",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-gingerchilli"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin"
      },
      {
        "q": "~1 tsp",
        "n": "Salt",
        "tag": "salt"
      },
      {
        "q": "~1/2 cup (120 ml)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~2 tbsp",
        "n": "Onion, finely chopped",
