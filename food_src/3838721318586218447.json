 "dish": {
  "id": "tandoori-paneer-sliders",
  "name": "Tandoori paneer sliders",
  "meal": "Snack",
  "minutes": 35,
  "protein": 20,
  "how": "Air fryer",
  "tools": "Air fryer, plate, silicone brush, fork, knife",
  "serves": 3,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~150 g, in small cubes",
    "n": "Paneer",
    "tag": "paneer",
    "img": "i-paneer"
   },
   {
    "q": "~1 small, chopped",
    "n": "Onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~1/3 cup",
    "n": "Tandoori sauce (thick, orange)",
    "tag": "tandoori-sauce",
    "img": "i-sauce"
   },
   {
    "q": "1 block of 6 joined buns",
    "n": "Ladi pav (soft buns)",
    "tag": "pav",
    "img": "i-pav",
    "alt": [
     "bread"
    ]
   },
   {
    "q": "~1.5 tbsp, melted",
    "n": "Butter",
    "tag": "butter",
    "img": "i-butter",
    "alt": [
     "oil"
    ]
   },
   {
    "q": "~1 medium, in slices",
    "n": "Tomato",
    "tag": "tomato",
    "img": "i-tomato"
   },
   {
    "q": "~4 slices",
    "n": "Cheese slices",
    "tag": "cheese",
    "img": "i-cheese"
   },
   {
    "q": "~1/2 tsp",
    "n": "Oregano",
    "tag": "oregano",
    "img": "i-oregano"
   },
   {
    "q": "~1/2 tsp",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "img": "i-flakes"
   },
   {
    "q": "~3 tbsp",
    "n": "Green chutney",
    "tag": "green-chutney",
    "img": "i-chutney"
   }
  ],
  "steps": [
   {
    "t": "Put the paneer cubes on a plate.",
    "imgs": [
     "s-paneer-1",
     "s-paneer-2"
    ]
   },
   {
    "t": "Add the chopped onion.",
    "imgs": [
     "s-onion-1",
     "s-onion-2"
    ]
   },
   {
    "t": "Pour the tandoori sauce over the paneer.",
    "imgs": [
     "s-sauce-1",
     "s-sauce-2"
    ]
   },
   {
    "t": "Mix well so the paneer is coated.",
    "imgs": [
     "s-mix-1",
     "s-mix-2",
     "s-mix-3"
    ]
   },
   {
    "t": "Cut the block of pav in half sideways.",
    "imgs": [
     "s-cut-1",
     "s-cut-2"
    ]
   },
   {
    "t": "Put the bottom half in the air fryer basket.",
    "imgs": [
     "s-base-1",
     "s-base-2"
    ]
   },
   {
    "t": "Brush the top of it with melted butter.",
    "imgs": [
     "s-butter-1",
     "s-butter-2",
     "s-butter-3"
    ]
   },
   {
    "t": "Air fry the base until golden.",
    "imgs": [
     "s-toast-1",
     "s-toast-2"
    ]
   },
   {
    "t": "Spread the paneer mix on the toasted base.",
    "imgs": [
     "s-spread-1",
     "s-spread-2"
    ]
   },
   {
    "t": "Lay the tomato slices on top.",
    "imgs": [
     "s-tomato-1",
     "s-tomato-2"
    ]
   },
   {
    "t": "Cover with the cheese slices.",
    "imgs": [
     "s-cheese-1",
     "s-cheese-2",
     "s-cheese-3"
    ]
   },
   {
    "t": "Sprinkle on the oregano and chilli flakes.",
    "imgs": [
     "s-season-1",
     "s-season-2",
     "s-season-3"
    ]
   },
   {
    "t": "Spread green chutney on the cut side of the top half of pav.",
    "imgs": [
     "s-chutney-1",
     "s-chutney-2",
     "s-chutney-3"
    ]
   },
   {
    "t": "Flip the top half over onto the cheese, chutney side down.",
    "imgs": [
     "s-top-1",
     "s-top-2"
    ]
   },
   {
    "t": "Press down. Mark the lines between the buns with a fork.",
    "imgs": [
     "s-press-1",
     "s-press-2",
     "s-press-3"
    ]
   },
   {
    "t": "Brush the tops of the buns with melted butter.",
    "imgs": [
     "s-brush-1",
     "s-brush-2",
     "s-brush-3"
    ]
   },
   {
    "t": "Air fry again until the buns are golden brown.",
    "imgs": [
     "s-bake-1",
     "s-bake-2"
    ]
   },
   {
    "t": "Cut along the lines into 6 sliders.",
    "imgs": [
     "s-slice-1",
     "s-slice-2",
     "s-slice-3"
    ]
   },
   {
    "t": "Lift out a slider and eat hot.",
    "imgs": [
     "s-serve-1",
     "s-serve-2"
    ]
   }
  ],
  "tags": [
   "air-fryer",
   "high-protein"
  ],
  "notes": "Silent video, no amounts and no air fryer temperature or time shown: all quantities are my estimates, and you will need to set the temperature and time yourself (watch for golden colour). The orange sauce is never named: it looks like tandoori mayonnaise or a tandoori marinade. If you use mayo, pick an eggless one with the green dot. The sprinkle on the cheese looks like oregano and chilli flakes."
 },
