        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Add the turmeric and red chilli powder.",
        "imgs": [
          "s-spice-1",
          "s-spice-2",
          "s-spice-3"
        ]
      },
      {
        "t": "Add the almonds.",
        "imgs": [
          "s-alm-1",
          "s-alm-2"
        ]
      },
      {
        "t": "Add the cashews and the dry coconut slices.",
        "imgs": [
          "s-cash-1",
          "s-cash-2"
        ]
      },
      {
        "t": "Roast, stirring, until the nuts turn golden.",
        "imgs": [
          "s-roast-1",
          "s-roast-2",
          "s-roast-3"
