     "s-spice-1",
     "s-spice-2",
     "s-spice-3"
    ]
   },
   {
    "t": "Stir until the chickpeas are coated and lightly browned.",
    "imgs": [
     "s-stir-1",
     "s-stir-2"
    ]
   },
   {
    "t": "Tip the chickpeas into the jar, over the cucumber.",
