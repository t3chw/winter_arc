  "dish": {
    "id": "drumstick-peanut-pickle",
    "name": "Drumstick peanut pickle",
    "meal": "Side",
    "minutes": 35,
    "protein": 0,
    "how": "Gas",
    "tools": "Pan, gas, mixie, glass jar, thin cloth",
    "serves": 10,
    "cover": "cover",
    "ingredients": [
      { "q": "250 g", "n": "Drumsticks / moringa pods (sahjan ki fali)", "tag": "drumstick", "img": "i-drumstick" },
      { "q": "1/2 cup", "n": "Garlic cloves, peeled", "tag": "garlic", "img": "i-garlic" },
      { "q": "1/2 cup", "n": "Green chilli", "tag": "green-chilli", "img": "i-chilli" },
      { "q": "to taste", "n": "Salt", "tag": "salt", "img": "i-salt" },
      { "q": "1/2 cup", "n": "Raw peanuts", "tag": "peanuts", "img": "i-peanuts" },
      { "q": "2 tbsp", "n": "Coriander seeds (sabut dhania)", "tag": "coriander-seeds", "img": "i-coriander" },
      { "q": "2 tbsp", "n": "Fennel seeds (saunf)", "tag": "fennel-seeds", "img": "i-fennel" },
      { "q": "1/2 tbsp", "n": "Cumin seeds (jeera)", "tag": "cumin", "img": "i-cumin" },
      { "q": "1 tbsp", "n": "Mustard seeds (rai)", "tag": "mustard-seeds", "img": "i-mustard" },
      { "q": "1/2 tbsp", "n": "Fenugreek seeds (methi dana)", "tag": "fenugreek-seeds", "img": "i-fenugreek" },
      { "q": "1/2 cup", "n": "Mustard oil (sarson ka tel)", "tag": "oil", "img": "i-oil" },
      { "q": "1 tsp", "n": "Carom seeds (ajwain)", "tag": "ajwain" },
      { "q": "2 tsp", "n": "Asafoetida (hing)", "tag": "hing" },
      { "q": "1/4 tsp", "n": "Turmeric powder (haldi)", "tag": "turmeric", "img": "i-turmeric" },
      { "q": "1 tsp", "n": "Kashmiri red chilli powder", "tag": "red-chilli-powder", "img": "i-chillipowder" },
      { "q": "1 tbsp", "n": "Vinegar", "tag": "vinegar", "img": "i-vinegar" }
    ],
    "steps": [
      { "t": "Peel the tough outer strings off 250 g drumsticks.", "imgs": ["s-peel-1", "s-peel-2"] },
      { "t": "Cut the drumsticks into small pieces.", "imgs": ["s-cut-1"] },
      { "t": "Wash the pieces well, then dry them on a cloth.", "imgs": ["s-wash-1", "s-wash-2"] },
      { "t": "Crush 1/2 cup garlic and 1/2 cup green chilli roughly.", "imgs": ["s-crush-1", "s-crush-2"] },
      { "t": "Add the crushed garlic and chilli to the drumstick pieces.", "imgs": ["s-add-1"] },
      { "t": "Add salt to taste and mix well.", "imgs": ["s-salt-1", "s-salt-2"] },
      { "t": "Dry roast 1/2 cup peanuts on low flame until brown spots show.", "imgs": ["s-pnut-1", "s-pnut-2"] },
      { "t": "Add coriander seeds 2 tbsp and fennel seeds 2 tbsp to the pan.", "imgs": ["s-spice-1", "s-spice-2"] },
      { "t": "Add cumin 1/2 tbsp, mustard 1 tbsp and fenugreek 1/2 tbsp. Roast lightly, about 2 minutes.", "imgs": ["s-spice-3", "s-spice-4"] },
      { "t": "Move the roasted spices to a plate.", "imgs": ["s-plate-1"] },
      { "t": "Heat 1/2 cup mustard oil, then switch off the flame. Let it cool to lukewarm.", "imgs": ["s-oil-1", "s-oil-2"] },
      { "t": "Grind the cooled spices coarsely in the mixie. Crush the roasted peanuts too.", "imgs": ["s-grind-1", "s-grind-2"] },
      { "t": "Add the ground masala and crushed peanuts to the drumstick bowl.", "imgs": ["s-masala-1", "s-masala-2"] },
      { "t": "Add ajwain 1 tsp and hing 2 tsp.", "imgs": ["s-ajwain-1"] },
      { "t": "Add turmeric 1/4 tsp and Kashmiri chilli powder 1 tsp.", "imgs": ["s-powder-1", "s-powder-2"] },
      { "t": "Pour in the lukewarm mustard oil and mix well.", "imgs": ["s-mix-1", "s-mix-2"] },
      { "t": "Add vinegar 1 tbsp and mix again.", "imgs": ["s-vinegar-1", "s-vinegar-2"] },
      { "t": "Fill a clean, dry glass jar with the pickle.", "imgs": ["s-jar-1"] },
      { "t": "Cover the jar with a thin cloth. Keep it in strong sun for 7 to 10 days.", "imgs": ["s-sun-1", "s-sun-2"] }
    ],
    "tags": ["gas", "blender", "make-ahead"],
    "credit": "Honest Kitchen",
    "notes": "Hands-on time is about 35 minutes, then 7 to 10 days of sun drying. On-screen text says hing 2 tsp (looks like a lot, 1/4 tsp is usual). Serves is a guess (about 1 tbsp each). No clear shot of ajwain, hing or peanut crushing. Video says it keeps up to a year."
  },
