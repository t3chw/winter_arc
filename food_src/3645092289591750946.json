  "dish": {
    "id": "soya-potato-cutlets",
    "name": "Air fryer soya potato cutlets",
    "meal": "Snack",
    "minutes": 40,
    "protein": 10,
    "how": "Air fryer",
    "tools": "Mixie, air fryer, grater, brush, glass bowl",
    "serves": 4,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1.5 cups (80 g) dry",
        "n": "Soya chunks",
        "tag": "soya-chunks",
        "img": "i-soya"
      },
      {
        "q": "~1/2 tsp, plus more in the mix",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "enough to cover",
        "n": "Water, for soaking",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "1 medium",
        "n": "Onion, in big pieces",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "2",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "5 to 6 cloves",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~1 inch piece",
        "n": "Ginger",
        "tag": "ginger",
        "img": "i-ginger"
      },
      {
        "q": "a big handful",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-corr"
      },
      {
        "q": "3 medium",
        "n": "Potatoes, boiled",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-redchilli"
      },
      {
        "q": "~1 tsp",
        "n": "Garam masala or cumin-coriander powder (brown masala)",
        "tag": "garam-masala",
        "alt": [
          "cumin-powder",
          "coriander-powder"
        ],
        "img": "i-masala"
      },
      {
        "q": "~1/4 tsp",
        "n": "Turmeric powder (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1/2 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~2 tbsp",
        "n": "Breadcrumbs or oat flour (beige powder binder, not named in the video)",
        "tag": "breadcrumbs",
        "alt": [
          "oats",
          "besan"
        ],
        "opt": true,
        "img": "i-binder"
      },
      {
        "q": "~50 g",
        "n": "Paneer, grated (the video says you can add it)",
        "tag": "paneer",
        "opt": true
      },
      {
        "q": "~1 tsp",
        "n": "Oil or ghee, to brush",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "a small bowl",
        "n": "Green chutney, to dip",
        "tag": "green-chutney",
        "opt": true,
        "img": "i-chutney"
      }
    ],
    "steps": [
      {
        "t": "Put the soya chunks in a glass bowl.",
        "imgs": [
          "s-soya-1",
          "s-soya-2"
        ]
      },
      {
        "t": "Add a little salt.",
        "imgs": [
          "s-salt-1"
        ]
      },
      {
        "t": "Pour water over the soya chunks and let them soak until soft.",
        "imgs": [
          "s-water-1",
          "s-water-2"
        ]
      },
      {
        "t": "Squeeze the soaked soya chunks well to remove the water.",
        "imgs": [
          "s-squeeze-1"
        ]
      },
      {
        "t": "Put the squeezed soya chunks in the mixie jar.",
        "imgs": [
          "s-jar-1"
        ]
      },
      {
        "t": "Add the onion and green chillies.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Add the garlic and ginger.",
        "imgs": [
          "s-garlic-1",
          "s-garlic-2"
        ]
      },
      {
        "t": "Add the coriander leaves.",
        "imgs": [
          "s-corr-1"
        ]
      },
      {
        "t": "Grind to a coarse, crumbly mince and tip it into a bowl.",
        "imgs": [
          "s-mince-1",
          "s-mince-2"
        ]
      },
      {
        "t": "Grate the boiled potatoes into the bowl.",
        "imgs": [
          "s-potato-1",
          "s-potato-2",
          "s-potato-3"
        ]
      },
      {
        "t": "Add the red chilli powder and the brown masala.",
        "imgs": [
          "s-spice-1",
          "s-spice-2"
        ]
      },
      {
        "t": "Add the turmeric, salt and cumin seeds.",
        "imgs": [
          "s-spice-3",
          "s-spice-4",
          "s-spice-5"
        ]
      },
      {
        "t": "Sprinkle on the breadcrumbs. Add grated paneer too if you like.",
        "imgs": [
          "s-binder-1",
          "s-binder-2"
        ]
      },
      {
        "t": "Mix and mash everything by hand until it holds together.",
        "imgs": [
          "s-mix-1",
          "s-mix-2"
        ]
      },
      {
        "t": "Press a small portion into a short roll, in any shape you like.",
        "imgs": [
          "s-shape-1",
          "s-shape-2",
          "s-shape-3"
        ]
      },
      {
        "t": "Repeat with the rest of the mix and set the cutlets on a plate.",
        "imgs": [
          "s-plate-1"
        ]
      },
      {
        "t": "Place the cutlets in the air fryer basket with space between them.",
        "imgs": [
          "s-basket-1",
          "s-basket-2"
        ]
      },
      {
        "t": "Brush each cutlet lightly with oil or ghee.",
        "imgs": [
          "s-brush-1",
          "s-brush-2",
          "s-brush-3"
        ]
      },
      {
        "t": "Air fry until golden brown and crisp.",
        "imgs": [
          "s-fry-1",
          "s-fry-2",
          "s-fry-3"
        ]
      },
      {
        "t": "Serve hot with green chutney.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "air-fryer",
      "blender",
      "high-fibre"
    ],
    "credit": "@yummy_tummy25",
    "notes": "English speech and on-screen text, but no amounts are given: the caption it refers to ('add all the ingredients mentioned in the caption') is not in the video, so all amounts and the spice names are my reading of the pictures. Brown masala could be garam masala or cumin-coriander powder. The beige powder added last is not named (looks like breadcrumbs or oat flour). Soaking time, air fryer temperature and time are not shown or said (it says you can also shallow fry in oil or ghee). Serves 4 is a guess: about 14 cutlets from this amount. Paneer is only mentioned, not shown."
  },
