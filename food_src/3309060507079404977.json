    "how": "Gas",
    "tools": "Pan, gas, ice cube tray, freezer, hand frother",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1 cup (200 ml)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~2 tbsp",
        "n": "Instant coffee powder",
        "tag": "coffee",
        "img": "i-coffee"
      },
      {
        "q": "~2 tbsp",
        "n": "Sugar",
        "tag": "sugar",
        "img": "i-sugar"
      },
      {
        "q": "~2 cups (400 ml)",
        "n": "Cold milk",
        "tag": "milk",
        "img": "i-milk"
      },
      {
        "q": "a pinch",
        "n": "Coffee powder, to sprinkle on top",
        "tag": "coffee",
        "opt": true,
        "img": "i-coffee-top"
      }
    ],
    "steps": [
      {
        "t": "Heat the water in a pan on the stove.",
        "imgs": [
          "s-heat-1"
        ]
      },
      {
        "t": "Add the coffee powder and sugar to the hot water.",
        "imgs": [
          "s-add-1",
          "s-add-2"
        ]
      },
      {
        "t": "Stir and let it bubble until the sugar melts and the coffee is dark.",
        "imgs": [
          "s-stir-1",
          "s-stir-2"
        ]
      },
      {
        "t": "Pour the hot coffee into ice cube trays.",
        "imgs": [
          "s-pour-1",
          "s-pour-2"
        ]
      },
      {
        "t": "Freeze until the coffee cubes are solid.",
        "imgs": [
          "s-freeze-1"
        ]
      },
      {
        "t": "Drop the coffee cubes into a glass.",
        "imgs": [
          "s-cubes-1",
          "s-cubes-2"
        ]
      },
      {
        "t": "Pour cold milk over the cubes.",
        "imgs": [
          "s-milk-1",
          "s-milk-2"
        ]
      },
      {
        "t": "Froth with a hand frother until the top is foamy.",
        "imgs": [
          "s-froth-1",
          "s-froth-2"
        ]
      },
      {
        "t": "Sprinkle a little coffee powder on top and serve.",
        "imgs": [
          "s-top-1",
          "s-top-2"
        ]
      }
    ],
    "tags": [
      "gas",
      "make-ahead"
    ],
    "notes": "The video shows no amounts and has no clear speech; all amounts are guesses (~). Freezing the cubes takes several hours (not counted in minutes). The video uses an induction hob, a gas stove works the same."
