    "img": "i-capsicum"
   },
   {
    "q": "~1 medium, in chunks",
    "n": "Tomato",
    "tag": "tomato",
    "img": "i-tomato"
   },
   {
    "q": "~4 tbsp",
    "n": "Thick curd (hung curd)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~1 tbsp",
    "n": "Ginger-garlic paste",
    "tag": "ginger",
    "alt": [
     "garlic"
    ],
    "img": "i-gg"
   },
   {
    "q": "~2 tbsp",
    "n": "Besan (gram flour)",
    "tag": "besan",
    "img": "i-besan"
   },
   {
    "q": "~1 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli"
   },
   {
    "q": "~1/2 tsp",
    "n": "Turmeric",
    "tag": "turmeric",
    "img": "i-turmeric"
   },
   {
    "q": "~1 tsp",
    "n": "Garam masala",
    "tag": "garam-masala",
    "img": "i-garam"
   },
   {
    "q": "~1 tsp",
    "n": "Kasuri methi (dried fenugreek leaves)",
    "tag": "kasuri-methi",
    "img": "i-methi"
   },
   {
    "q": "~1/2 tsp, to taste",
    "n": "Salt",
    "tag": "salt"
   },
   {
    "q": "~1 tbsp, melted",
    "n": "Ghee or butter",
