    "opt": true,
    "img": "i-chutney"
   },
   {
    "q": "~1/2 onion, in rings",
    "n": "Onion rings",
    "tag": "onion",
    "opt": true,
    "img": "i-rings"
   },
   {
    "q": "a pinch",
    "n": "Chaat masala",
    "tag": "chaat-masala",
    "opt": true,
    "img": "i-chaat"
   },
   {
    "q": "1/2",
    "n": "Lemon",
    "tag": "lemon",
    "opt": true,
    "img": "i-lemon"
   },
   {
    "q": "a few leaves, chopped",
    "n": "Coriander leaves",
    "tag": "coriander-leaves",
    "opt": true,
    "img": "i-coriander"
   }
  ],
  "steps": [
   {
    "t": "Put the paneer cubes in the air fryer basket.",
    "imgs": [
     "s-paneer-1"
    ]
   },
   {
    "t": "Add the onion, capsicum and tomato chunks.",
    "imgs": [
     "s-veg-1",
     "s-veg-2"
    ]
   },
   {
    "t": "Add the thick curd on top.",
    "imgs": [
     "s-curd-1",
     "s-curd-2"
    ]
   },
   {
    "t": "Add the ginger-garlic paste and besan.",
    "imgs": [
     "s-paste-1",
     "s-paste-2"
    ]
   },
   {
    "t": "Sprinkle on the red chilli powder.",
    "imgs": [
     "s-chilli-1"
    ]
   },
   {
    "t": "Add the turmeric and garam masala.",
    "imgs": [
     "s-spice-1",
     "s-spice-2"
    ]
   },
   {
    "t": "Sprinkle on the kasuri methi and salt.",
    "imgs": [
     "s-methi-1"
    ]
   },
   {
    "t": "Pour over the melted ghee or butter.",
    "imgs": [
     "s-ghee-1"
    ]
   },
   {
    "t": "Mix well with your hands until everything is coated.",
    "imgs": [
     "s-mix-1",
     "s-mix-2",
     "s-mix-3"
    ]
   },
   {
    "t": "Slide the basket into the air fryer.",
    "imgs": [
     "s-in-1"
    ]
   },
   {
    "t": "Air fry at 200 C for 12 minutes.",
    "imgs": [
     "s-fry-1",
     "s-fry-2",
     "s-fry-3"
    ]
   },
   {
    "t": "Take the basket out when the paneer is browned at the edges.",
    "imgs": [
     "s-out-1",
     "s-out-2"
    ]
   },
   {
    "t": "Move the paneer and vegetables to a plate.",
    "imgs": [
     "s-plate-1"
    ]
   },
   {
    "t": "Add the green chutney and onion rings on the side.",
    "imgs": [
     "s-plate-2"
    ]
   },
   {
    "t": "Sprinkle a pinch of chaat masala over the paneer.",
    "imgs": [
     "s-chaat-1"
    ]
   },
   {
    "t": "Squeeze lemon juice over the top.",
    "imgs": [
     "s-lemon-1"
    ]
   },
   {
    "t": "Garnish with chopped coriander and eat hot.",
    "imgs": [
     "s-garnish-1",
     "s-garnish-2"
    ]
   }
  ],
  "tags": [
   "air-fryer",
   "high-protein"
  ],
  "notes": "No on-screen text and no usable speech: all amounts are estimates (~). The yellow paste and pale powder (ginger-garlic paste, besan), the brown spice (garam masala), the pinch sprinkled on the plate (chaat masala) and the melted ghee-or-butter are my best guesses from the pictures. Salt and any resting time before cooking are not shown. Timer reads 12 min at 200 C."
