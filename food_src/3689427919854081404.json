    "imgs": [
     "s-fry-1",
     "s-fry-2"
    ]
   },
   {
    "t": "Melt butter in a pan and add chopped garlic.",
    "imgs": [
     "s-butter-1"
    ]
   },
   {
    "t": "Add bell pepper strips, onion rings and tomato slices.",
    "imgs": [
     "s-veg-1",
     "s-veg-2"
    ]
   },
   {
    "t": "Add salt and chilli flakes and toss until just soft.",
    "imgs": [
