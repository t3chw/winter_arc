 "dish": {
  "id": "beetroot-dhokla",
  "name": "Beetroot dhokla",
  "meal": "Snack",
  "minutes": 40,
  "protein": 5,
  "how": "Gas",
  "tools": "Mixie, steamer pan with stand, round tin, small pan, gas",
  "serves": 3,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1 medium (120 g), chopped",
    "n": "Beetroot",
    "tag": "beetroot",
    "img": "i-beetroot"
   },
   {
    "q": "3/4 cup in all",
    "n": "Water",
    "tag": "water",
    "img": "i-water"
   },
   {
    "q": "~1 cup (100 g), 2 scoops",
    "n": "Besan (gram flour)",
    "tag": "besan",
    "img": "i-besan"
   },
   {
    "q": "1/2 tsp",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "1/2 tsp",
    "n": "Sugar",
    "tag": "sugar",
    "img": "i-sugar"
   },
   {
    "q": "a little",
    "n": "Lime juice",
    "tag": "lemon",
    "img": "i-lime"
   },
   {
    "q": "1 sachet (~5 g)",
    "n": "Eno fruit salt",
    "tag": "fruit-salt",
    "img": "i-eno",
    "alt": [
     "baking-soda"
    ]
   },
   {
    "q": "~1 tbsp",
    "n": "Oil, for the tadka",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1 tsp in all",
    "n": "Mustard seeds (black, and pale yellow ones)",
    "tag": "mustard-seeds",
    "img": "i-mustard"
   },
   {
    "q": "~2",
    "n": "Green chillies, sliced",
    "tag": "green-chilli",
    "img": "i-chilli"
   },
   {
    "q": "~8 leaves",
    "n": "Curry leaves",
    "tag": "curry-leaves",
    "img": "i-curry"
   },
   {
    "q": "~1 tsp",
    "n": "Sesame seeds",
    "tag": "sesame-seeds",
    "img": "i-sesame"
   },
   {
    "q": "2 slices",
    "n": "Lime, sliced, to serve",
    "tag": "lemon",
    "opt": true,
    "img": "i-limeslice"
   }
  ],
  "steps": [
