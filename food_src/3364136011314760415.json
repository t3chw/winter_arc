  "dish": {
    "id": "aloo-katliyan",
    "name": "Aloo katliyan",
    "meal": "Side",
    "minutes": 20,
    "protein": 5,
    "how": "Gas",
    "tools": "Kadhai (wok), gas, spoon, knife",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "2 tbsp",
        "n": "Mustard oil",
        "tag": "oil",
        "alt": [
          "ghee"
        ],
        "img": "i-oil"
      },
      {
        "q": "1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "1 tsp",
        "n": "Nigella seeds (kalonji)",
        "tag": "nigella-seeds",
        "img": "i-nigella"
      },
      {
        "q": "1/2 tsp",
        "n": "Hing (asafoetida)",
        "tag": "hing",
        "img": "i-hing"
      },
      {
        "q": "~3 medium (350 g)",
        "n": "Potatoes, sliced into thin rounds",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "to taste (~1 tsp)",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "2 to 3 pinches",
        "n": "Turmeric (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "2, crushed",
        "n": "Dry red chilli",
        "tag": "dry-red-chilli",
        "alt": [
          "chilli-flakes"
        ],
        "img": "i-chilli"
      },
      {
        "q": "2 medium",
        "n": "Onion, sliced",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "2, cut in strips",
        "n": "Green chilli",
        "tag": "green-chilli",
        "img": "i-green-chilli"
      },
      {
        "q": "1 tbsp",
        "n": "Dry fenugreek leaves (kasuri methi)",
        "tag": "kasuri-methi",
        "opt": true,
        "img": "i-kasuri"
      },
      {
        "q": "~1/4 cup, chopped",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      }
    ],
    "steps": [
      {
        "t": "Peel the potatoes and cut them into thin round slices.",
        "imgs": [
          "s-slice-1"
        ]
      },
      {
        "t": "Heat 2 tbsp mustard oil in a kadhai on the gas.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add 1 tsp cumin seeds.",
        "imgs": [
          "s-cumin-1",
          "s-cumin-2"
        ]
      },
      {
        "t": "Add 1 tsp nigella seeds (kalonji).",
        "imgs": [
          "s-nigella-1",
          "s-nigella-2"
        ]
      },
      {
        "t": "Add 1/2 tsp hing.",
        "imgs": [
          "s-hing-1",
          "s-hing-2"
        ]
      },
      {
        "t": "Add the potato slices.",
        "imgs": [
          "s-potato-1",
          "s-potato-2"
        ]
      },
      {
        "t": "Spread the slices out and shallow fry them.",
        "imgs": [
          "s-fry-1",
          "s-fry-2"
        ]
      },
      {
        "t": "Sprinkle salt over the potatoes.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Add 2 to 3 pinches of turmeric.",
        "imgs": [
          "s-turmeric-1",
          "s-turmeric-2"
        ]
      },
      {
        "t": "Add the 2 crushed dry red chillies.",
        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Stir often on medium to high heat.",
        "imgs": [
          "s-stir-1",
          "s-stir-2",
          "s-stir-3"
        ]
      },
      {
        "t": "Cook until the potato is about half cooked, with golden edges.",
        "imgs": [
          "s-half-1",
          "s-half-2"
        ]
      },
      {
        "t": "Add the sliced onion.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Add the 2 green chillies, cut in strips.",
        "imgs": [
          "s-greenchilli-1"
        ]
      },
      {
        "t": "Cook for 5 to 6 minutes, stirring, until the potato is golden and soft.",
        "imgs": [
          "s-golden-1",
          "s-golden-2"
        ]
      },
      {
        "t": "Sprinkle 1 tbsp dry fenugreek leaves (kasuri methi) on top.",
        "imgs": [
          "s-kasuri-1",
          "s-kasuri-2"
        ]
      },
      {
        "t": "Add the chopped coriander leaves.",
        "imgs": [
          "s-coriander-1",
          "s-coriander-2"
        ]
      },
      {
        "t": "Toss everything together and serve hot.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "credit": "Honest Kitchen",
    "notes": "Amounts for oil, cumin, nigella, hing, chillies, onion and kasuri methi are shown on screen. Potato amount, salt amount and coriander amount are guesses (~). Slicing the potato is not shown (used the slices frame). Potatoes are shallow fried, not boiled. Dish is low in protein: goes well with dal or curd."
  },
