   },
   {
    "q": "~1 tsp",
    "n": "Coriander powder",
    "tag": "coriander-powder",
    "img": "i-corpow"
   },
   {
    "q": "~1, chopped fine",
    "n": "Green chilli",
    "tag": "green-chilli",
    "img": "i-gchilli"
   },
   {
    "q": "a small handful, chopped",
    "n": "Coriander leaves",
    "tag": "coriander-leaves",
