        "opt": true
      },
      {
        "q": "1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1.5 cups (250 g), boiled",
        "n": "Chickpeas (chole), boiled",
