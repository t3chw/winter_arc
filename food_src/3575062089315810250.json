        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "a handful, chopped",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander",
        "opt": true
      },
      {
        "q": "~1/2 tsp",
        "n": "Garam masala",
