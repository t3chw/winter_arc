        "img": "i-garammasala"
      },
      {
        "q": "~1/2 tsp, to taste",
        "n": "Salt",
        "tag": "salt"
      }
    ],
    "steps": [
      {
        "t": "Put the curd in the mixie jar.",
        "imgs": [
          "s-curd-1",
          "s-curd-2"
        ]
      },
      {
        "t": "Add cashews, ginger-garlic paste and green chillies.",
        "imgs": [
          "s-jar-1",
          "s-jar-2",
          "s-jar-3"
        ]
      },
      {
        "t": "Add turmeric, red chilli powder and coriander powder.",
        "imgs": [
          "s-spice-1",
          "s-spice-2",
          "s-spice-3"
        ]
      },
      {
        "t": "Blend into a smooth, thick paste.",
        "imgs": [
          "s-blend-1",
          "s-blend-2"
        ]
      },
      {
        "t": "Heat oil in a pan. Add cumin seeds and curry leaves.",
        "imgs": [
          "s-tadka-1"
        ]
      },
      {
        "t": "Add the chopped tomato. Cook until it turns soft and mushy.",
        "imgs": [
          "s-tomato-1",
          "s-tomato-2",
          "s-tomato-3"
        ]
      },
      {
        "t": "Pour in the curd paste and stir well.",
        "imgs": [
          "s-gravy-1",
          "s-gravy-2",
          "s-gravy-3"
        ]
      },
      {
        "t": "Cover and cook until red oil shows on top.",
        "imgs": [
          "s-cover-1",
          "s-cover-2"
        ]
      },
      {
        "t": "Add the boiled chickpeas.",
        "imgs": [
          "s-chole-1",
          "s-chole-2"
        ]
      },
      {
        "t": "Add sliced onion rings, chopped coriander and garam masala.",
        "imgs": [
          "s-top-1",
          "s-top-2",
          "s-top-3"
        ]
      },
      {
        "t": "Mix everything well.",
        "imgs": [
          "s-mix-1"
        ]
      },
      {
        "t": "Cover and cook for 2 to 3 minutes.",
        "imgs": [
          "s-simmer-1",
          "s-simmer-2"
        ]
      },
      {
        "t": "Serve hot with rice or roti.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender",
      "high-fibre"
    ],
    "credit": "myflavourfuljourney",
    "notes": "No amounts are given, so all quantities are guesses. Chickpeas are already boiled. Salt is never shown but the gravy needs it. Heat levels are not shown. The two pastes (ginger, garlic) are hard to tell apart on screen. Curry leaf in the tadka is a guess from one green leaf."
