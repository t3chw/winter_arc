 "dish": {
  "id": "rajma-paneer-roti-tacos",
  "name": "Rajma paneer roti tacos",
  "meal": "Lunch or dinner",
  "minutes": 30,
  "protein": 15,
  "how": "Gas",
  "tools": "Non-stick pan, gas, flat press (masher), fork, bowl, brush",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~3/4 cup (130 g), boiled",
    "n": "Kidney beans (rajma)",
    "tag": "rajma",
    "img": "i-rajma"
   },
   {
    "q": "~50 g, grated",
    "n": "Paneer",
    "tag": "paneer",
    "img": "i-paneer"
   },
   {
    "q": "a pinch",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~1/2 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli-powder"
   },
   {
    "q": "~1/2 tsp",
    "n": "Cumin powder (jeera)",
    "tag": "cumin-powder",
    "img": "i-cumin"
   },
   {
    "q": "~1 tsp",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "opt": true,
    "img": "i-flakes"
   },
   {
    "q": "~2 tbsp",
    "n": "Eggless mayonnaise (or hung curd)",
    "tag": "mayonnaise",
    "alt": [
     "curd"
    ],
    "img": "i-mayo"
   },
   {
    "q": "~1 tbsp",
    "n": "Schezwan sauce",
    "tag": "schezwan-sauce",
    "img": "i-schezwan"
   },
   {
    "q": "~1/2 tsp",
    "n": "Oregano",
    "tag": "oregano",
    "img": "i-oregano"
   },
   {
    "q": "~2 tbsp, chopped",
    "n": "Red onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~1 tsp",
    "n": "Ghee",
    "tag": "ghee",
    "img": "i-ghee"
   },
   {
    "q": "2 small rotis",
    "n": "Roti (chapati)",
    "tag": "roti",
    "img": "i-roti"
   },
   {
    "q": "2 slices",
    "n": "Cheese slices",
    "tag": "cheese",
    "img": "i-cheese"
   }
  ],
  "steps": [
   {
    "t": "Put the boiled kidney beans on a plate.",
    "imgs": [
     "s-beans-1",
     "s-beans-2"
    ]
   },
   {
    "t": "Mash the beans with a fork.",
    "imgs": [
     "s-mash-1",
     "s-mash-2"
    ]
   },
   {
    "t": "Add the grated paneer.",
    "imgs": [
     "s-paneer-1",
     "s-paneer-2"
    ]
   },
   {
    "t": "Add the salt.",
    "imgs": [
     "s-salt-1",
     "s-salt-2"
    ]
   },
   {
    "t": "Add the red chilli powder, cumin powder and chilli flakes.",
    "imgs": [
     "s-spice-1",
     "s-spice-2",
     "s-spice-3"
    ]
   },
   {
    "t": "Mix everything well with your hand.",
    "imgs": [
     "s-mix-1",
     "s-mix-2"
    ]
   },
   {
    "t": "Shape the mix into round, flat patties.",
    "imgs": [
     "s-patty-1",
     "s-patty-2",
     "s-patty-3"
    ]
   },
   {
    "t": "In a small bowl, put the mayo and add the schezwan sauce.",
    "imgs": [
     "s-mayo-1",
     "s-mayo-2"
    ]
   },
   {
    "t": "Add salt, oregano and chilli flakes.",
    "imgs": [
     "s-season-1",
     "s-season-2"
    ]
   },
   {
    "t": "Mix well, then stir in the chopped onion.",
    "imgs": [
     "s-season-3",
     "s-onion-1",
     "s-onion-2"
    ]
   },
   {
    "t": "Heat a pan on the gas and brush it with ghee.",
    "imgs": [
     "s-ghee-1",
     "s-ghee-2"
    ]
   },
   {
    "t": "Put one patty on the pan.",
    "imgs": [
     "s-put-1"
    ]
   },
   {
    "t": "Place a roti on top of the patty.",
    "imgs": [
     "s-roti-1"
    ]
   },
   {
    "t": "Press down hard with a flat press to smash it flat.",
    "imgs": [
     "s-press-1",
     "s-press-2",
     "s-press-3"
    ]
   },
   {
    "t": "Sprinkle chilli flakes on the roti.",
    "imgs": [
     "s-flakes-1",
     "s-flakes-2"
    ]
   },
   {
    "t": "Flip it and brush the patty side with ghee until crisp.",
    "imgs": [
     "s-flip-1",
     "s-flip-2",
     "s-flip-3"
    ]
   },
   {
    "t": "Lift it onto a plate with the patty side up.",
    "imgs": [
     "s-plate-1",
     "s-plate-2"
    ]
   },
   {
    "t": "Lay the cheese slices on the patty.",
    "imgs": [
     "s-cheese-1",
     "s-cheese-2"
    ]
   },
   {
    "t": "Sprinkle some oregano on the cheese.",
    "imgs": [
     "s-oregano-1"
    ]
   },
   {
    "t": "Spoon the onion mayo mix on top.",
    "imgs": [
     "s-sauce-1",
     "s-sauce-2"
    ]
   },
   {
    "t": "Fold the roti over to close the taco.",
    "imgs": [
     "s-fold-1",
     "s-fold-2"
    ]
   },
   {
    "t": "Serve hot. Repeat for the next taco.",
    "imgs": [
     "s-serve-1",
     "s-serve-2"
    ]
   }
  ],
  "tags": [
   "gas",
   "high-fibre"
  ],
  "notes": "No amounts given in the video: all quantities are guesses. Only the on-screen words are available; the 'basic spices' are shown but not named: red chilli powder is clear, the brown powder looks like cumin. The yellow-cap bottle on the cheese looks like oregano. Cooking times are not shown. The mix makes about 3 patties; only 2 tacos are shown. Pick an eggless mayo or use hung curd."
