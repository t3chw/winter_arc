  "dish": {
    "id": "palak-paneer-roti",
    "name": "Palak paneer roti",
    "meal": "Lunch or dinner",
    "minutes": 35,
    "protein": 15,
    "how": "Gas",
    "tools": "Blender (mixie), tawa, gas",
    "serves": 3,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~3 big handfuls (~150 g)",
        "n": "Spinach (palak)",
        "tag": "spinach",
        "img": "i-spinach"
      },
      {
        "q": "~1/2 cup cubes (~80 g)",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~1 inch piece",
        "n": "Ginger (adrak)",
        "tag": "ginger",
        "img": "i-gingerchilli"
      },
      {
        "q": "~2",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-gingerchilli"
      },
      {
        "q": "~2 cups (~250 g)",
        "n": "Whole wheat flour (atta)",
        "tag": "atta",
        "img": "i-atta"
      },
      {
        "q": "~1 tsp",
        "n": "Salt",
        "tag": "salt"
      },
      {
        "q": "a little",
        "n": "Ghee, to brush on top",
        "tag": "ghee",
        "img": "i-ghee",
        "opt": true
      }
    ],
    "steps": [
      {
        "t": "Put the spinach in a bowl.",
        "imgs": [
          "s-spinach-1",
          "s-spinach-2"
        ]
      },
      {
        "t": "Add the paneer cubes.",
        "imgs": [
          "s-paneer-1"
        ]
      },
      {
        "t": "Add the ginger and green chillies.",
        "imgs": [
          "s-ginger-1",
          "s-ginger-2"
        ]
      },
      {
        "t": "Blend everything into a smooth green puree.",
        "imgs": [
          "s-puree-1"
        ]
      },
      {
        "t": "Put the whole wheat flour in a big bowl.",
        "imgs": [
          "s-flour-1",
          "s-flour-2"
        ]
      },
      {
        "t": "Pour the spinach paneer puree over the flour.",
        "imgs": [
          "s-puree-pour-1"
        ]
      },
      {
        "t": "Add the salt.",
        "imgs": [
          "s-salt-1"
        ]
      },
      {
        "t": "Knead into a soft dough. A stand mixer or your hands both work.",
        "imgs": [
          "s-knead-1",
          "s-knead-2"
        ]
      },
      {
        "t": "Roll a small ball of dough into a thin round roti.",
        "imgs": [
          "s-roll-1",
          "s-roll-2"
        ]
      },
      {
        "t": "Cook the roti on a hot tawa.",
        "imgs": [
          "s-tawa-1"
        ]
      },
      {
        "t": "Cook it from both sides, then puff it over the open flame.",
        "imgs": [
          "s-flame-1",
          "s-flame-2"
        ]
      },
      {
        "t": "Brush a little ghee on the hot rotis and stack them.",
        "imgs": [
          "s-ghee-1",
          "s-ghee-2"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender"
    ],
    "credit": "@yumfood_artz",
    "notes": "No audio and no amounts shown (only on-screen ingredient names): all quantities are guesses. Tawa time is not shown. Dough is kneaded in a stand mixer in the video; by hand works too. Ghee brushing is shown at the start of the video (assumed done at the end). No water added to the puree in the video."
