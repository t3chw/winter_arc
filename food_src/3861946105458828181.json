        "alt": [
          "ghee"
        ]
      },
      {
        "q": "~2 cups (about 25 g)",
        "n": "Makhana (fox nuts)",
        "tag": "makhana",
        "img": "i-makhana"
      },
      {
        "q": "a pinch",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/2 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli"
      },
      {
        "q": "~1/2 tsp",
        "n": "Chaat masala",
        "tag": "chaat-masala",
        "img": "i-chaat-masala"
      },
      {
        "q": "~1/2 small",
        "n": "Onion, finely chopped",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1/2 small",
        "n": "Tomato, finely chopped",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1/4 cup",
        "n": "Cucumber, finely chopped",
        "tag": "cucumber",
        "img": "i-cucumber"
      },
      {
        "q": "~1",
        "n": "Green chilli, chopped",
        "tag": "green-chilli",
        "img": "i-green-chilli"
      },
      {
        "q": "~1 tbsp",
        "n": "Green chutney (mint-coriander)",
        "tag": "green-chutney",
        "img": "i-chutney"
      },
      {
        "q": "1/2",
        "n": "Lime (nimbu)",
        "tag": "lemon",
        "img": "i-lime"
      },
      {
        "q": "~1 tbsp",
        "n": "Coriander leaves, chopped",
        "tag": "coriander-leaves",
        "img": "i-coriander",
        "opt": true
      },
      {
        "q": "~1/4 cup",
        "n": "Sev",
        "tag": "sev",
        "img": "i-sev",
        "opt": true
      }
    ],
    "steps": [
      {
        "t": "Chop the onion, tomato, cucumber and green chilli into small pieces.",
        "imgs": [
          "s-prep-1"
        ]
      },
      {
        "t": "Pour about 2 tsp oil into a kadhai on the gas.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add about 2 cups makhana.",
        "imgs": [
          "s-makhana-1",
          "s-makhana-2"
        ]
      },
      {
        "t": "Sprinkle on a pinch of salt.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Sprinkle on about 1/2 tsp red chilli powder.",
        "imgs": [
          "s-redchilli-1",
          "s-redchilli-2"
        ]
      },
      {
        "t": "Stir and roast the makhana on the gas.",
        "imgs": [
          "s-roast-1",
          "s-roast-2",
          "s-roast-3"
        ]
      },
      {
        "t": "Add about 1/2 tsp chaat masala and toss.",
        "imgs": [
          "s-masala-1",
          "s-masala-2"
        ]
      },
      {
        "t": "Keep roasting until the makhana are golden and crisp.",
        "imgs": [
          "s-golden-1",
          "s-golden-2",
          "s-golden-3"
        ]
      },
      {
        "t": "Add the chopped onion.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Add the chopped tomato.",
        "imgs": [
          "s-tomato-1",
          "s-tomato-2"
        ]
      },
      {
        "t": "Add the chopped cucumber.",
        "imgs": [
          "s-cucumber-1",
          "s-cucumber-2"
        ]
      },
      {
        "t": "Add the chopped green chilli.",
        "imgs": [
          "s-greenchilli-1",
          "s-greenchilli-2"
        ]
      },
      {
        "t": "Add about 1 tbsp green chutney.",
        "imgs": [
          "s-chutney-1",
          "s-chutney-2"
        ]
      },
      {
        "t": "Squeeze half a lime over it.",
        "imgs": [
          "s-lime-1",
          "s-lime-2"
        ]
      },
      {
        "t": "Sprinkle on chopped coriander leaves.",
        "imgs": [
          "s-coriander-1",
          "s-coriander-2"
        ]
      },
      {
        "t": "Add about 1/4 cup sev.",
        "imgs": [
          "s-sev-1",
          "s-sev-2"
        ]
      },
      {
        "t": "Toss everything well and serve.",
        "imgs": [
          "s-toss-1",
          "s-toss-2"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "credit": "Raksha's Kitchen",
    "notes": "Silent video (music only), no amounts shown: all amounts (~) and the 15 min total are my estimates. The white pinch at the start looks like salt; the tan powder looks like chaat masala but is not named on screen. The first liquid looks like oil but could be melted ghee. The prep step has only the glass bowl of chopped veg as its picture (chopping itself is not shown). Low protein snack (about 2 to 4 g per serving); I put 5 as the nearest step. Creator name taken from the on-screen watermark."
