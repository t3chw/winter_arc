  "dish": {
    "id": "pressure-cooker-veg-paneer-pulao",
    "name": "Pressure cooker paneer veg pulao",
    "meal": "Lunch or dinner",
    "minutes": 30,
    "protein": 15,
    "how": "Pressure cooker",
    "tools": "Pressure cooker, gas or induction, spoon",
    "serves": 3,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~3 tbsp",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "1 large (~1 cup)",
        "n": "Onion, sliced",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "1 small (~1/2 cup)",
        "n": "Carrot, small cubes",
        "tag": "carrot",
        "img": "i-carrot"
      },
      {
        "q": "~3/4 cup (100 g)",
        "n": "Green peas",
        "tag": "peas",
        "img": "i-peas"
      },
      {
        "q": "2",
        "n": "Green chillies, slit",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "~1 tsp",
        "n": "Ginger-garlic paste",
        "tag": "ginger",
        "alt": [
          "garlic"
        ],
        "img": "i-gg"
      },
      {
        "q": "~1 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-redchilli"
      },
      {
        "q": "~1.5 cups (270 g)",
        "n": "Basmati rice, washed",
        "tag": "rice",
        "img": "i-rice"
      },
      {
        "q": "~2 cups (500 ml)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~1 tsp",
        "n": "Pulao masala or garam masala",
        "tag": "garam-masala",
        "img": "i-masala"
      },
      {
        "q": "~100 g (8 to 10 cubes)",
        "n": "Paneer, cubed and lightly fried",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~1 tsp",
        "n": "Ghee, to finish",
        "tag": "ghee",
        "opt": true,
        "img": "i-ghee"
      },
      {
        "q": "a small handful",
        "n": "Coriander leaves, chopped",
        "tag": "coriander-leaves",
        "opt": true,
        "img": "i-coriander"
      },
      {
        "q": "1 small bowl",
        "n": "Raita (curd with onion, tomato), to serve",
        "tag": "curd",
        "opt": true,
        "img": "i-raita"
      }
    ],
    "steps": [
      {
        "t": "Heat oil in the pressure cooker.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add the cumin seeds.",
        "imgs": [
          "s-cumin-1"
        ]
      },
      {
        "t": "Add the sliced onion.",
        "imgs": [
          "s-onion-1",
          "s-onion-2"
        ]
      },
      {
        "t": "Stir until the onion turns soft and light golden.",
        "imgs": [
          "s-fry-1",
          "s-fry-2"
        ]
      },
      {
        "t": "Add the carrot and green peas.",
        "imgs": [
          "s-carrot-1",
          "s-peas-1",
          "s-peas-2"
        ]
      },
      {
        "t": "Add the slit green chillies and the ginger-garlic paste.",
        "imgs": [
          "s-chilli-1",
          "s-gg-1"
        ]
      },
      {
        "t": "Add the salt and the red chilli powder.",
        "imgs": [
          "s-salt-1",
          "s-redchilli-1",
          "s-redchilli-2"
        ]
      },
      {
        "t": "Stir well and cook the vegetables for a minute or two.",
        "imgs": [
          "s-stir-1",
          "s-stir-2",
          "s-stir-3"
        ]
      },
      {
        "t": "Add the washed rice.",
        "imgs": [
          "s-rice-1",
          "s-rice-2"
        ]
      },
      {
        "t": "Pour in the water.",
        "imgs": [
          "s-water-1",
          "s-water-2",
          "s-water-3"
        ]
      },
      {
        "t": "Add the pulao masala on top.",
        "imgs": [
          "s-masala-1",
          "s-masala-2"
        ]
      },
      {
        "t": "Add the fried paneer cubes.",
        "imgs": [
          "s-paneer-1",
          "s-paneer-2"
        ]
      },
      {
        "t": "Mix gently so the rice and water are even.",
        "imgs": [
          "s-mix-1",
          "s-mix-2"
        ]
      },
      {
        "t": "Close the lid, put on the weight and pressure cook on high flame.",
        "imgs": [
          "s-lid-1",
          "s-lid-2",
          "s-lid-3"
        ]
      },
      {
        "t": "Wait until the pressure goes, then open the lid.",
        "imgs": [
          "s-open-1",
          "s-open-2"
        ]
      },
      {
        "t": "Drizzle ghee over the pulao.",
        "imgs": [
          "s-ghee-1",
          "s-ghee-2"
        ]
      },
      {
        "t": "Sprinkle chopped coriander leaves on top.",
        "imgs": [
          "s-coriander-1",
          "s-coriander-2"
        ]
      },
      {
        "t": "Fluff and mix gently with a spoon.",
        "imgs": [
          "s-fluff-1",
          "s-fluff-2"
        ]
      },
      {
        "t": "Serve hot with raita.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "pressure-cooker",
      "one-pot"
    ],
    "notes": "Hindi speech (cut off in my transcript) and no on-screen amounts, so all amounts are my estimates from the glass, spoons and bowls. The whistle count and cooking time are not shown or clearly said (basmati usually needs 1 to 2 whistles on high): I wrote 'wait until pressure goes'. The pot looks like it is on an induction plate (use your gas). The spoon after the green chilli is ginger-garlic paste (white garlic piece visible); no turmeric is shown. The brown-green powder on the rice looks like pulao masala or garam masala. Paneer is already fried golden in a glass bowl (the frying is not shown). The cooker is shown first as the finished dish; steps follow the cooking order. The raita is only shown as a side."
  },
