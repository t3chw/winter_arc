  "videos": ["3593921647977600104"],
  "dish": {
    "id": "gond-katira-sharbat",
    "name": "Gond katira sharbat",
    "meal": "Drink",
    "minutes": 20,
    "protein": 0,
    "how": "No cooking",
    "tools": "Mixie (grinder jar), sieve, tall glass, jar",
    "serves": 1,
    "cover": "cover",
    "ingredients": [
      { "q": "~1 tbsp (small handful)", "n": "Gond katira (edible gum)", "tag": "gond-katira", "img": "i-gond" },
      { "q": "~1 1/2 cups (soaking + drink)", "n": "Water", "tag": "water", "img": "i-water" },
      { "q": "~1/4 cup", "n": "Fennel seeds (saunf)", "tag": "fennel-seeds", "img": "i-saunf" },
      { "q": "~1/2 cup", "n": "Rock sugar (mishri)", "tag": "rock-sugar", "img": "i-mishri", "alt": ["sugar"] },
      { "q": "~1 tsp", "n": "Black pepper, whole", "tag": "black-pepper", "img": "i-pepper" },
      { "q": "~1 tsp", "n": "Dry ginger powder (sonth)", "tag": "dry-ginger-powder", "img": "i-sonth", "opt": true },
      { "q": "~1/2 tsp", "n": "Black salt (kala namak)", "tag": "black-salt", "img": "i-blacksalt" },
      { "q": "~1 tbsp, soaked", "n": "Sabja (basil) seeds", "tag": "basil-seeds", "img": "i-sabja" },
      { "q": "~3 cubes", "n": "Ice", "tag": "ice", "img": "i-ice" },
      { "q": "~8 leaves", "n": "Mint leaves", "tag": "mint-leaves", "img": "i-mint" },
      { "q": "1/2", "n": "Lemon", "tag": "lemon", "img": "i-lemon" }
    ],
    "steps": [
      { "t": "Put the gond katira in a small glass.", "imgs": ["s-gond-1", "s-gond-2"] },
      { "t": "Pour in water and stir. Leave to soak for a few hours until it swells into jelly.", "imgs": ["s-gond-3", "s-gond-4", "s-gond-5"] },
      { "t": "Premix: put the fennel seeds in a dry mixie jar.", "imgs": ["s-saunf-1", "s-saunf-2"] },
      { "t": "Add the rock sugar and the black pepper.", "imgs": ["s-mix-1", "s-mix-2"] },
      { "t": "Add the dry ginger powder and the black salt.", "imgs": ["s-mix-3", "s-mix-4"] },
      { "t": "Grind to a fine powder.", "imgs": ["s-grind-1", "s-grind-2"] },
      { "t": "Sieve the powder into a bowl.", "imgs": ["s-sieve-1", "s-sieve-2", "s-sieve-3"] },
      { "t": "Tip the coarse bits from the sieve back into the jar and grind again.", "imgs": ["s-regrind-1"] },
      { "t": "Fill a dry glass jar with the powder and close the lid.", "imgs": ["s-jar-1", "s-jar-2", "s-jar-3"] },
      { "t": "Sharbat: put 2 spoons of the soaked gond katira in a tall glass.", "imgs": ["s-glass-1", "s-glass-2"] },
      { "t": "Add the soaked sabja seeds.", "imgs": ["s-sabja-1"] },
      { "t": "Add the ice cubes and the mint leaves.", "imgs": ["s-ice-1", "s-ice-2"] },
      { "t": "Squeeze in the lemon juice.", "imgs": ["s-lemon-1", "s-lemon-2"] },
      { "t": "Add 2 heaped spoons of the premix.", "imgs": ["s-premix-1"] },
      { "t": "Pour in cold water and stir well.", "imgs": ["s-water-1", "s-water-2", "s-water-3"] }
    ],
    "tags": ["no-cook", "blender", "make-ahead"],
    "credit": "poonamscookery_",
    "notes": "Amounts are guesses (~): the video gives none except '2 spoons of premix' for one glass. The premix jar is enough for about 6 to 8 glasses and keeps. The beige powder is my guess for dry ginger powder (optional). Soaking time of the gond (a few hours) is not counted in minutes; the sabja seeds are shown already soaked (usually 10 to 15 min in water)."
  },
