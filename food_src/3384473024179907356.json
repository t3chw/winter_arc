    "img": "i-ghee"
   },
   {
    "q": "~⅓ cup (40 g)",
    "n": "Cashews",
    "tag": "cashews",
    "img": "i-cashews"
   },
   {
    "q": "~⅓ cup (45 g)",
    "n": "Almonds",
    "tag": "almonds",
    "img": "i-almonds"
   },
   {
    "q": "~¼ cup (30 g)",
    "n": "Pistachios",
    "tag": "pistachios",
    "img": "i-pistachio"
   },
   {
    "q": "~⅓ cup (50 g)",
