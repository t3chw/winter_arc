  "dish": {
    "id": "multigrain-ragi-oats-dosa",
    "name": "Multigrain ragi oats dosa",
    "meal": "Breakfast",
    "minutes": 30,
    "protein": 5,
    "how": "Gas",
    "tools": "Bowl, whisk, tawa, gas",
    "serves": 4,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~3 cups (~700 ml)",
        "n": "Ready dosa batter",
        "tag": "dosa-batter",
        "img": "i-batter"
      },
      {
        "q": "~3 tbsp",
        "n": "Ragi flour (nachni atta)",
        "tag": "millet",
        "img": "i-ragi"
      },
      {
        "q": "~3 tbsp",
        "n": "Oats, ground to powder",
        "tag": "oats",
        "img": "i-oats"
      },
      {
        "q": "~1 tbsp",
        "n": "Flax seeds, ground (alsi)",
        "tag": "flax-seeds",
        "img": "i-flax"
      },
      {
        "q": "~3 tbsp",
        "n": "Whole wheat flour (atta)",
        "tag": "atta",
        "img": "i-wheat"
      },
      {
        "q": "a pinch",
        "n": "Hing (asafoetida)",
        "tag": "hing"
      },
      {
        "q": "~1 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/2 cup (120 ml)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "~1/2 cup",
        "n": "Coriander leaves (for the paste)",
        "tag": "coriander-leaves",
        "img": "i-paste"
      },
      {
        "q": "~10 leaves",
        "n": "Curry leaves (for the paste)",
        "tag": "curry-leaves",
        "img": "i-paste"
      },
      {
        "q": "~1 inch piece",
        "n": "Ginger (for the paste)",
        "tag": "ginger",
        "img": "i-paste"
      },
      {
        "q": "~2",
        "n": "Green chillies (for the paste)",
        "tag": "green-chilli",
        "img": "i-paste"
      },
      {
        "q": "~1 tsp per dosa",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "to serve",
        "n": "Chutney",
        "tag": "chutney",
        "img": "i-chutney",
        "opt": true
      },
      {
        "q": "to serve",
        "n": "Podi (chilli-lentil powder)",
        "tag": "podi-masala",
        "img": "i-podi",
        "opt": true
      }
    ],
    "steps": [
      {
        "t": "Put the dosa batter in a large bowl.",
        "imgs": [
          "s-batter-1",
          "s-batter-2",
          "s-batter-3"
        ]
      },
      {
        "t": "Add the ragi flour and ground oats.",
        "imgs": [
          "s-flour-1",
          "s-flour-2",
          "s-flour-3"
        ]
      },
      {
        "t": "Add the ground flax seeds and whole wheat flour.",
        "imgs": [
          "s-flax-1",
          "s-flax-2"
        ]
      },
      {
        "t": "Add hing and salt.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Pour in the water.",
        "imgs": [
          "s-water-1"
        ]
      },
      {
        "t": "Whisk well until there are no lumps.",
        "imgs": [
          "s-mix-1",
          "s-mix-2",
          "s-mix-3"
        ]
      },
      {
        "t": "Pour in the green paste and whisk until the batter is even.",
        "imgs": [
          "s-paste-1",
          "s-paste-2",
          "s-paste-3"
        ]
      },
      {
        "t": "Heat a tawa on the gas until it is very hot.",
        "imgs": [
          "s-heat-1",
          "s-heat-2"
        ]
      },
      {
        "t": "Pour a ladle of batter in the middle of the tawa.",
        "imgs": [
          "s-pour-1",
          "s-pour-2"
        ]
      },
      {
        "t": "Spread the batter in circles into a thin dosa.",
        "imgs": [
          "s-spread-1",
          "s-spread-2",
          "s-spread-3"
        ]
      },
      {
        "t": "Drizzle oil over the dosa.",
        "imgs": [
          "s-oil-1"
        ]
      },
      {
        "t": "Cook until the dosa turns crisp and golden.",
        "imgs": [
          "s-cook-1",
          "s-cook-2"
        ]
      },
      {
        "t": "Fold the dosa with a spatula.",
        "imgs": [
          "s-fold-1",
          "s-fold-2"
        ]
      },
      {
        "t": "Serve hot with chutney and podi.",
        "imgs": [
          "s-serve-1",
          "s-serve-2",
          "s-serve-3"
        ]
      }
    ],
    "tags": [
      "gas"
