    "imgs": [
     "s-curd-1"
    ]
   },
   {
    "t": "Add salt to the yogurt.",
    "imgs": [
     "s-salt-1"
    ]
   },
   {
    "t": "Add the finely chopped garlic.",
    "imgs": [
     "s-garlic-1"
    ]
   },
   {
    "t": "Whisk the yogurt well.",
    "imgs": [
     "s-whisk-1"
    ]
   },
   {
    "t": "Heat a little oil in a small pan.",
    "imgs": [
     "s-oil-1"
    ]
   },
   {
    "t": "Add turmeric, red chilli powder and kasuri methi to the oil.",
