    ]
   },
   {
    "t": "Heat 1 tablespoon of ghee in a pan.",
    "imgs": [
     "s-ghee-2",
     "s-ghee-1"
    ]
   },
   {
    "t": "Add turmeric, red chilli powder and coriander powder.",
    "imgs": [
