     "s-onion-1"
    ]
   },
   {
    "t": "Add the green chilli.",
    "imgs": [
     "s-gchilli-1"
    ]
   },
   {
    "t": "Add the chopped coriander leaves.",
    "imgs": [
     "s-corleaf-1"
    ]
   },
   {
    "t": "Mix it well.",
    "imgs": [
     "s-mix-1"
    ]
   },
   {
