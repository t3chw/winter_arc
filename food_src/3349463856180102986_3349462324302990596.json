  "dish": {
    "id": "masala-paneer-buddha-bowl",
    "name": "Masala paneer buddha bowl",
    "meal": "Lunch or dinner",
    "minutes": 45,
    "protein": 25,
    "how": "Gas",
    "tools": "Pan, gas, mixie (small jar), bowls, spoons",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~150 g (8 cubes)",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~3 tbsp, in parts",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1/4 tsp",
        "n": "Turmeric (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1/4 tsp",
        "n": "Pale spice powder (looks like chaat masala or amchur)",
        "tag": "chaat-masala",
        "alt": [
          "amchur"
        ],
        "img": "i-pale"
      },
      {
        "q": "~1/2 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli-powder"
      },
      {
        "q": "~1/2 tsp",
        "n": "Brown spice powder (looks like cumin or garam masala)",
        "tag": "cumin-powder",
        "alt": [
          "garam-masala"
        ],
        "img": "i-brown"
      },
      {
        "q": "~2 tsp, in parts",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~10 cloves, chopped, in parts",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "a small handful, chopped",
        "n": "Green garlic (seasonal)",
        "tag": "green-garlic",
        "opt": true,
        "img": "i-green-garlic"
      },
      {
        "q": "~3",
        "n": "Green chilli",
        "tag": "green-chilli",
        "img": "i-green-chilli"
      },
      {
        "q": "~1 cup, loosely packed",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "~1 cup, loosely packed",
        "n": "Spinach",
        "tag": "spinach",
        "img": "i-spinach"
      },
      {
        "q": "1 (about 2 tbsp juice)",
        "n": "Lemon",
        "tag": "lemon",
        "img": "i-lemon"
      },
      {
        "q": "~1 1/2 medium (1 for the rice, 1/2 for the salad)",
        "n": "Onion, sliced",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~2 cups (300 g)",
        "n": "Cooked rice, basmati",
        "tag": "rice",
        "img": "i-rice"
      },
      {
        "q": "a pinch",
        "n": "Hing (asafoetida)",
        "tag": "hing"
      },
      {
        "q": "~1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato",
        "alt": [
          "carrot"
        ]
      },
      {
        "q": "~1 cup (100 g)",
        "n": "Cauliflower, small florets",
        "tag": "cauliflower",
        "img": "i-cauli"
      },
      {
        "q": "~1/2 cup (75 g)",
        "n": "Green peas",
        "tag": "peas",
        "img": "i-peas"
      },
      {
        "q": "~1 cup (240 g)",
        "n": "Thick curd (dahi)",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "~1/2 medium, grated",
        "n": "Cucumber",
        "tag": "cucumber",
        "img": "i-cucumber"
      },
      {
        "q": "~1 small, grated",
        "n": "Beetroot",
        "tag": "beetroot",
        "img": "i-beet"
      }
    ],
    "steps": [
      {
        "t": "Cut the paneer into cubes and put them in a bowl.",
        "imgs": [
          "s-cut-2"
        ]
      },
      {
        "t": "Drizzle some oil over the paneer.",
        "imgs": [
          "s-oil-1"
        ]
      },
      {
        "t": "Add the turmeric and the pale spice powder.",
        "imgs": [
          "s-spice-1"
        ]
      },
      {
        "t": "Add the red chilli powder and the brown spice powder.",
        "imgs": [
          "s-spice-3",
          "s-spice-4"
        ]
      },
      {
        "t": "Add the salt.",
        "imgs": [
          "s-salt-1"
        ]
      },
      {
        "t": "Toss gently until every cube is coated. Keep aside.",
        "imgs": [
          "s-toss-2"
        ]
      },
      {
        "t": "Heat oil in a pan on medium heat.",
        "imgs": [
          "s-heat-1"
        ]
      },
      {
        "t": "Add the chopped garlic and green garlic. Stir for a few seconds.",
        "imgs": [
          "s-garlic-1",
          "s-garlic-2"
        ]
      },
      {
        "t": "Add the marinated paneer.",
        "imgs": [
          "s-fry-1"
        ]
      },
      {
        "t": "Fry, turning, until golden on all sides. Take it out.",
        "imgs": [
          "s-fry-4"
        ]
      },
      {
        "t": "Put the green chillies in a small mixie jar.",
        "imgs": [
          "s-chutney-1"
        ]
      },
      {
        "t": "Add the coriander leaves.",
        "imgs": [
          "s-chutney-3"
        ]
      },
      {
        "t": "Press in the spinach leaves.",
        "imgs": [
          "s-chutney-5"
        ]
      },
      {
        "t": "Add the salt, a squeeze of lemon and the chopped garlic.",
        "imgs": [
          "s-chutney-7",
          "s-chutney-9"
        ]
      },
      {
        "t": "Blend to a smooth green chutney.",
        "imgs": [
          "s-blend-2"
        ]
      },
      {
        "t": "Heat oil in a pan.",
        "imgs": [
          "s-rice-oil-1"
        ]
      },
      {
        "t": "Add the sliced onion and cook until soft.",
        "imgs": [
          "s-rice-onion-1"
        ]
      },
      {
        "t": "Add the chopped garlic and green chilli. Stir.",
        "imgs": [
          "s-rice-garlic-1",
          "s-rice-garlic-2"
        ]
      },
      {
        "t": "Pour in the green chutney and cook until thick.",
        "imgs": [
          "s-rice-chutney-1"
        ]
      },
      {
        "t": "Add the cooked rice.",
        "imgs": [
          "s-rice-add-1"
        ]
      },
      {
        "t": "Add salt and mix well until every grain is green.",
        "imgs": [
          "s-rice-mix-1",
          "s-rice-mix-2"
        ]
      },
      {
        "t": "Put sliced onion in a bowl.",
        "imgs": [
          "s-onion-2"
        ]
      },
      {
        "t": "Squeeze lemon juice over the onion, add salt and mix.",
        "imgs": [
          "s-onion-3",
          "s-onion-4"
        ]
      },
      {
        "t": "Heat oil in a pan. Add the chopped garlic and a pinch of hing.",
        "imgs": [
          "s-veg-garlic-1"
        ]
      },
      {
        "t": "Add the tomato and stir.",
        "imgs": [
          "s-veg-tomato-1"
        ]
      },
      {
        "t": "Add the cauliflower florets.",
        "imgs": [
          "s-veg-cauli-1"
        ]
      },
      {
        "t": "Add the green peas.",
        "imgs": [
          "s-veg-peas-1"
        ]
      },
      {
        "t": "Sprinkle a little salt and stir for 1 to 2 minutes.",
        "imgs": [
          "s-veg-salt-1"
        ]
      },
      {
        "t": "Put thick curd in a bowl.",
        "imgs": [
          "s-raita-1"
        ]
      },
      {
        "t": "Add the grated cucumber.",
        "imgs": [
          "s-raita-3"
        ]
      },
      {
        "t": "Add the grated beetroot.",
        "imgs": [
          "s-raita-4"
        ]
      },
      {
        "t": "Add a pinch of salt and the chopped coriander leaves.",
        "imgs": [
          "s-raita-6",
          "s-raita-7"
        ]
      },
      {
        "t": "Mix well until the raita turns pink.",
        "imgs": [
          "s-raita-8"
        ]
      },
      {
        "t": "Put the fried paneer in a wide bowl.",
        "imgs": [
          "s-bowl-1"
        ]
      },
      {
        "t": "Add the sauteed vegetables next to the paneer.",
        "imgs": [
          "s-bowl-3"
        ]
      },
      {
        "t": "Add the lemon-onion salad and the chutney rice.",
        "imgs": [
          "s-bowl-5",
          "s-bowl-6"
        ]
      },
      {
        "t": "Serve with a bowl of beetroot raita and a lemon wedge.",
        "imgs": [
          "s-serve-1"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender",
      "high-protein"
    ],
    "credit": "The Pink Apron (Jalpa Gada)",
    "notes": "No amounts are given in the video, all amounts are guesses (~). Rice is already cooked. The pale and brown marinade powders are not named on screen (guessed). The red vegetable in the sauteed mix looks like tomato but could be red carrot. Hing is only in the speech, not seen. Optional mint in the chutney is not shown. The video is an induction hob and a non-stick pan; gas works the same."
  },
