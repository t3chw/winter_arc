  "dish": {
    "id": "aloo-peanut-salad",
    "name": "Aloo peanut curd salad",
    "meal": "Snack",
    "minutes": 25,
    "protein": 15,
    "how": "Gas",
    "tools": "Non-stick pan with lid, mixing bowl, gas",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1/2 cup (~70 g)",
        "n": "Peanuts (moongphali)",
        "tag": "peanuts",
        "img": "i-peanut"
      },
      {
        "q": "~1 tbsp",
        "n": "Oil",
        "tag": "oil"
      },
      {
        "q": "~1/2 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin"
      },
      {
        "q": "~2 medium (~200 g), diced small",
        "n": "Potatoes (aloo)",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~8 leaves",
        "n": "Curry leaves",
        "tag": "curry-leaves",
        "img": "i-curry"
      },
      {
        "q": "~1/2 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/2 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli"
      },
      {
        "q": "~1 1/2 cups (~350 g)",
        "n": "Curd (dahi)",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "~1/2 medium, chopped",
        "n": "Cucumber",
        "tag": "cucumber",
        "img": "i-cucumber"
      },
      {
        "q": "~1 small, chopped",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1/2 tsp",
        "n": "Chaat masala",
        "tag": "chaat-masala",
        "img": "i-chaat"
      }
    ],
    "steps": [
      {
        "t": "Dry roast the peanuts in a pan, then keep them aside.",
        "imgs": [
          "s-peanut-1"
        ]
      },
      {
        "t": "Heat oil in a non-stick pan.",
        "imgs": [
          "s-oil-1"
        ]
      },
      {
        "t": "Add the cumin seeds.",
        "imgs": [
          "s-cumin-1"
        ]
      },
      {
        "t": "Add the diced potatoes.",
        "imgs": [
          "s-potato-1"
        ]
      },
      {
        "t": "Add the curry leaves and stir.",
        "imgs": [
          "s-leaf-1",
          "s-leaf-2"
        ]
      },
      {
        "t": "Add the salt.",
        "imgs": [
          "s-salt-1"
        ]
      },
      {
        "t": "Cover with a lid and cook the potatoes soft.",
        "imgs": [
          "s-lid-1"
        ]
      },
      {
        "t": "Stir until the potatoes turn golden and crisp.",
        "imgs": [
          "s-gold-1",
          "s-gold-2"
        ]
      },
      {
        "t": "Add the roasted peanuts.",
        "imgs": [
          "s-pnut-1",
          "s-pnut-2"
        ]
      },
      {
        "t": "Add the red chilli powder and mix well.",
        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Put the curd in a bowl.",
        "imgs": [
          "s-curd-1"
        ]
      },
      {
        "t": "Add chopped cucumber, onion and tomato.",
        "imgs": [
          "s-veg-1",
          "s-veg-2"
        ]
      },
      {
        "t": "Add the chaat masala and mix well.",
        "imgs": [
          "s-chaat-1",
          "s-chaat-2"
        ]
      },
      {
        "t": "Top with the potato and peanut mix and sprinkle a little more masala.",
        "imgs": [
          "s-top-1",
          "s-top-2",
          "s-top-3"
        ]
      }
    ],
    "tags": [
      "gas"
