  "dish": {
    "id": "aloo-peanut-salad",
    "name": "Aloo peanut curd salad",
    "meal": "Snack",
    "minutes": 25,
    "protein": 15,
    "how": "Gas",
    "tools": "Non-stick pan with lid, mixing bowl, gas",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~1/2 cup (~70 g)",
        "n": "Peanuts (moongphali)",
        "tag": "peanuts",
        "img": "i-peanut"
      },
      {
        "q": "~1 tbsp",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1/2 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~2 medium (~200 g), diced small",
        "n": "Potatoes (aloo)",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~8 leaves",
        "n": "Curry leaves",
        "tag": "curry-leaves",
        "img": "i-curry"
      },
      {
        "q": "~1/2 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1/2 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli"
      },
      {
        "q": "~1 1/2 cups (~350 g)",
        "n": "Curd (dahi)",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "~1/2 medium, chopped",
        "n": "Cucumber",
        "tag": "cucumber",
        "img": "i-cucumber"
      },
      {
        "q": "~1 small, chopped",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1/2 tsp",
        "n": "Chaat masala",
        "tag": "chaat-masala",
        "img": "i-chaat"
      }
    ],
    "steps": [
      {
        "t": "Dry roast the peanuts in a pan, then keep them aside.",
        "imgs": [
          "s-peanut-1"
        ]
      },
      {
        "t": "Heat oil in a non-stick pan.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add the cumin seeds.",
        "imgs": [
          "s-cumin-1",
          "s-cumin-2"
        ]
      },
      {
        "t": "Add the diced potatoes.",
        "imgs": [
          "s-potato-1",
          "s-potato-2"
        ]
      },
      {
        "t": "Add the curry leaves and stir.",
        "imgs": [
          "s-leaf-1",
          "s-leaf-2",
          "s-leaf-3"
        ]
      },
      {
        "t": "Stir the potatoes for a minute.",
        "imgs": [
          "s-stir-1",
          "s-stir-2"
        ]
      },
      {
        "t": "Add the salt.",
        "imgs": [
          "s-salt-1",
          "s-salt-2"
        ]
      },
      {
        "t": "Cover with a lid and cook until the potatoes are soft.",
        "imgs": [
          "s-lid-1",
          "s-lid-2"
        ]
      },
      {
        "t": "Stir until the potatoes turn golden and crisp.",
        "imgs": [
          "s-gold-1",
          "s-gold-2"
        ]
      },
      {
        "t": "Add the roasted peanuts.",
        "imgs": [
          "s-pnut-1",
          "s-pnut-2"
        ]
      },
      {
        "t": "Add the red chilli powder and mix well.",
        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Put the curd in a bowl and spread it out.",
        "imgs": [
          "s-curd-1",
          "s-curd-2"
        ]
      },
      {
        "t": "Add chopped cucumber, tomato and onion.",
        "imgs": [
          "s-veg-1",
          "s-veg-2",
          "s-veg-3"
        ]
      },
      {
        "t": "Sprinkle chaat masala on the vegetables.",
        "imgs": [
          "s-chaat-1",
          "s-chaat-2"
        ]
      },
      {
        "t": "Mix everything well into the curd.",
        "imgs": [
          "s-mix-1",
          "s-mix-2"
        ]
      },
      {
        "t": "Top with the potato peanut mix and a little more masala.",
        "imgs": [
          "s-top-1",
          "s-top-2",
          "s-top-3",
          "s-top-4"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "notes": "Hindi voiceover is garbled and no amounts are on screen: all quantities are guesses and cooking times are not shown. The first ~11 seconds are an intro of the creator eating it (not used). The powder sprinkled on the curd and on top looks like chaat masala (matches the voiceover). The yellow tint on the potatoes suggests turmeric was added off-screen; not included. Peanuts are already roasting in the pan at the first cooking frame (so 'dry roast' is assumed). Salt thumbnail is a small frame."
  },
