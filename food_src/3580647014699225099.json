  "dish": {
    "id": "dry-fruit-apple-banana-shake",
    "name": "Dry fruit apple banana shake",
    "meal": "Drink",
    "minutes": 35,
    "protein": 25,
    "how": "No cooking",
    "tools": "Bowl, small blender cup, glass",
    "serves": 1,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~8",
        "n": "Cashews",
        "tag": "cashews",
        "img": "i-cashews"
      },
      {
        "q": "~8",
        "n": "Almonds",
        "tag": "almonds",
        "img": "i-almonds"
      },
      {
        "q": "~5",
        "n": "Dates, pitted",
        "tag": "dates",
        "img": "i-dates"
      },
      {
        "q": "~1 tbsp (a few kept for topping)",
        "n": "Pistachios",
        "tag": "pistachios",
        "img": "i-pistachios"
      },
      {
        "q": "a pinch",
        "n": "Saffron (kesar)",
        "tag": "saffron",
        "img": "i-saffron"
      },
      {
        "q": "~2 cups (1 to soak, 1 to blend)",
        "n": "Milk",
        "tag": "milk",
        "img": "i-milk"
      },
      {
        "q": "~1/2 small, cubed",
        "n": "Apple",
        "tag": "apple",
        "img": "i-apple"
      },
      {
        "q": "1, sliced",
        "n": "Banana",
        "tag": "banana",
        "img": "i-banana"
      }
    ],
    "steps": [
      {
        "t": "Put cashews, almonds and dates in a bowl.",
        "imgs": [
          "s1-1",
          "s1-2",
          "s1-3"
        ]
      },
      {
        "t": "Add pistachios and a pinch of saffron.",
        "imgs": [
          "s2-1",
          "s2-2"
        ]
      },
      {
        "t": "Pour in about 1 cup of milk.",
        "imgs": [
          "s3-1",
          "s3-2"
        ]
      },
      {
        "t": "Cover the bowl and keep it aside for 30 minutes.",
        "imgs": [
          "s4-1",
          "s4-2",
          "s4-3"
        ]
      },
      {
        "t": "Pour the soaked mix into a blender cup.",
        "imgs": [
          "s5-1",
          "s5-2"
        ]
      },
      {
        "t": "Add chopped apple and sliced banana.",
        "imgs": [
          "s6-1",
          "s6-2",
          "s6-3"
        ]
      },
      {
        "t": "Pour in more milk.",
        "imgs": [
          "s7-1"
        ]
      },
      {
        "t": "Close the lid and blend until smooth.",
        "imgs": [
          "s8-1",
          "s8-2"
        ]
      },
      {
        "t": "Pour the shake into a glass.",
        "imgs": [
          "s9-1",
          "s9-2",
          "s9-3"
        ]
      },
      {
        "t": "Top with pistachio slivers and a few dried rose petals.",
        "imgs": [
          "s10-1",
          "s10-2"
        ]
      }
    ],
    "tags": [
      "no-cook",
      "blender",
      "high-protein"
    ],
    "credit": "Chinky's Kitchen (@chinkyskitchen)",
    "notes": "Silent video, no amounts shown: every quantity is my guess. Dry fruit soak is 30 minutes (on-screen). Rose petals are a garnish only. Makes about one big mug."
  },
