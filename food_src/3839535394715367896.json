    "img": "i-dates"
   },
   {
    "q": "~12 whole",
    "n": "Almonds",
    "tag": "almonds",
    "img": "i-almonds"
   },
   {
    "q": "~150 g, melted",
    "n": "Chocolate (milk or dark)",
    "tag": "chocolate",
    "img": "i-chocolate",
    "alt": [
     "chocolate-chips"
    ]
   },
   {
    "q": "~30 g, melted",
    "n": "White chocolate",
    "tag": "white-chocolate",
    "img": "i-white"
   },
   {
    "q": "~2 tbsp",
    "n": "Flaked almonds",
    "tag": "almonds",
    "img": "i-flakes",
    "opt": true
   },
   {
    "q": "a pinch",
    "n": "Edible gold dust",
    "tag": "edible-gold",
    "img": "i-gold",
    "opt": true
   }
  ],
  "steps": [
   {
    "t": "Cut a date in two.",
    "imgs": [
     "s-cut-1",
     "s-cut-2"
    ]
   },
   {
    "t": "Put a whole almond between the two pieces.",
    "imgs": [
     "s-almond-1",
     "s-almond-2"
    ]
   },
   {
    "t": "Press the pieces together into a heart shape.",
    "imgs": [
     "s-heart-1",
     "s-heart-2",
     "s-heart-3"
    ]
   },
   {
    "t": "Dip the heart in the melted chocolate.",
    "imgs": [
     "s-dip-1",
     "s-dip-2"
    ]
   },
   {
    "t": "Turn it with a fork until it is fully coated.",
    "imgs": [
     "s-turn-1",
     "s-turn-2",
     "s-turn-3"
    ]
   },
   {
    "t": "Lift it out and let the extra chocolate drip off.",
    "imgs": [
     "s-lift-1",
     "s-lift-2"
    ]
   },
   {
    "t": "Place it on a lined tray.",
    "imgs": [
     "s-tray-1",
     "s-tray-2",
     "s-tray-3"
    ]
   },
   {
    "t": "Drizzle melted white chocolate on top.",
    "imgs": [
     "s-drizzle-1",
     "s-drizzle-2",
     "s-drizzle-3"
    ]
   },
   {
    "t": "Press a few flaked almonds on top.",
    "imgs": [
     "s-flake-1",
     "s-flake-2"
    ]
   },
   {
    "t": "Brush on a little gold dust.",
    "imgs": [
     "s-gold-1",
     "s-gold-2"
    ]
   }
  ],
  "tags": [
