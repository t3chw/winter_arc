   },
   {
    "q": "~1/2 tsp, to brush the guava",
    "n": "Oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "1 inch piece, chopped",
    "n": "Ginger",
    "tag": "ginger",
    "img": "i-ginger"
   },
   {
    "q": "7 to 8 (~20 g), chopped",
    "n": "Walnuts (akhrot)",
    "tag": "walnuts",
    "img": "i-walnuts"
   },
   {
    "q": "2 to 3",
    "n": "Green chillies",
    "tag": "green-chilli",
    "img": "i-chilli"
   },
   {
    "q": "a few leaves",
    "n": "Mint leaves (pudina)",
    "tag": "mint",
    "img": "i-mint"
   },
   {
    "q": "1 tsp",
    "n": "Lemon juice",
    "tag": "lemon",
    "img": "i-lemon"
   },
   {
    "q": "1 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-redchilli"
   },
   {
    "q": "1 tsp",
    "n": "Chaat masala",
    "tag": "chaat-masala",
    "img": "i-chaat"
   },
   {
    "q": "1 tsp",
    "n": "Roasted cumin powder (bhuna jeera)",
    "tag": "cumin-powder",
    "img": "i-jeera"
   },
   {
    "q": "~1/2 tsp, to taste",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   }
  ],
  "steps": [
   {
    "t": "Prick the whole guava all over with a fork.",
    "imgs": [
     "s-prick-1",
     "s-prick-2",
     "s-prick-3"
    ]
   },
   {
