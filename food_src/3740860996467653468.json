     "s-salt-2"
    ]
   },
   {
    "t": "Mix everything well with a spoon.",
    "imgs": [
     "s-mix-1",
     "s-mix-2"
    ]
   },
   {
    "t": "Spoon the chutney out into a bowl.",
    "imgs": [
     "s-spoon-1",
     "s-spoon-2"
    ]
   },
   {
    "t": "Top with a mint leaf and serve.",
    "imgs": [
     "s-serve-1",
     "s-serve-2"
    ]
   }
