    "imgs": [
     "s-add-1",
     "s-add-2"
    ]
   },
   {
    "t": "Mix well until the veggies are coated in the sauce.",
    "imgs": [
     "s-sauce-1",
     "s-sauce-2",
     "s-sauce-3"
    ]
   },
   {
    "t": "In a second pan, heat a little oil and add chilli flakes.",
    "imgs": [
     "s-rflakes-1",
     "s-rflakes-2"
    ]
   },
   {
    "t": "Add the chopped coriander leaves.",
    "imgs": [
     "s-rcoriander-1",
     "s-rcoriander-2"
    ]
   },
   {
    "t": "Add the cooked rice.",
    "imgs": [
     "s-rrice-1",
     "s-rrice-2"
    ]
   },
   {
