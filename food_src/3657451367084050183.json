 "dish": {
  "id": "creamy-veggie-herb-rice",
  "name": "Creamy veggie paneer herb rice",
  "meal": "Lunch or dinner",
  "minutes": 30,
  "protein": 30,
  "how": "Gas",
  "tools": "Non-stick pan, wok or second pan, gas, spatula, ladle, bowl",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~200 g",
    "n": "Paneer",
    "tag": "paneer",
    "img": "i-paneer"
   },
   {
    "q": "~1 tbsp, plus 1 tsp for the rice",
    "n": "Oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1 cup (150 g)",
    "n": "Broccoli florets",
    "tag": "broccoli",
    "img": "i-broccoli"
   },
   {
    "q": "~1 cup (150 g)",
    "n": "Capsicum (red, yellow and green), chopped",
    "tag": "capsicum",
    "img": "i-capsicum"
   },
   {
    "q": "~1/2 cup (80 g)",
    "n": "Sweet corn kernels",
    "tag": "corn",
    "img": "i-corn"
   },
   {
    "q": "~1 tsp, plus a pinch for the rice",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "img": "i-flakes"
   },
   {
    "q": "~1 tsp",
    "n": "Dried oregano or mixed herbs",
    "tag": "oregano",
    "img": "i-oregano",
    "alt": [
     "mixed-herbs"
    ]
   },
   {
    "q": "~1 tbsp",
    "n": "Butter",
    "tag": "butter",
    "img": "i-butter"
   },
   {
    "q": "~1.5 tbsp",
    "n": "Maida (plain white flour)",
    "tag": "all-purpose-flour",
    "alt": [
     "corn-flour"
    ],
    "img": "i-flour"
   },
   {
    "q": "~1 cup (250 ml)",
    "n": "Milk",
    "tag": "milk",
    "img": "i-milk"
   },
   {
    "q": "~1.5 cups (250 g) cooked",
    "n": "Cooked rice",
    "tag": "rice",
    "img": "i-rice"
   },
   {
    "q": "~2 tbsp",
    "n": "Coriander leaves, chopped",
    "tag": "coriander-leaves",
    "img": "i-coriander"
   }
  ],
  "steps": [
   {
