  "dish": {
    "id": "masala-nimbu-shikanji",
    "name": "Masala nimbu shikanji",
    "meal": "Drink",
    "minutes": 15,
    "protein": 0,
    "how": "Gas + blender",
    "tools": "Pan, gas, mixie, jar, glass",
    "serves": 1,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~2 tbsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~2 tbsp",
        "n": "Coriander seeds (sabut dhania)",
        "tag": "coriander-seeds",
        "img": "i-coriander"
      },
      {
        "q": "~2 tbsp",
        "n": "Fennel seeds (saunf)",
        "tag": "fennel-seeds",
        "img": "i-fennel"
      },
      {
        "q": "~1 tsp",
        "n": "Black pepper (kali mirch)",
        "tag": "black-pepper",
        "img": "i-pepper"
      },
      {
        "q": "~2 tsp",
        "n": "Dry ginger powder (sonth)",
        "tag": "dry-ginger-powder",
        "img": "i-ginger"
      },
      {
        "q": "~2 tsp",
        "n": "Black salt (kala namak)",
        "tag": "black-salt",
        "img": "i-blacksalt"
      },
      {
        "q": "~4 pods",
        "n": "Green cardamom (elaichi)",
        "tag": "cardamom",
        "img": "i-cardamom"
      },
      {
        "q": "~1/4 cup",
        "n": "Rock sugar (mishri)",
        "tag": "rock-sugar",
        "img": "i-mishri"
      },
      {
        "q": "~6 leaves",
        "n": "Mint leaves (pudina)",
        "tag": "mint",
        "img": "i-mint"
      },
      {
        "q": "~2 tbsp (1 to 2 lemons)",
        "n": "Lemon juice",
        "tag": "lemon",
        "img": "i-lemon"
      },
      {
        "q": "~4 cubes",
        "n": "Ice cubes",
        "tag": "ice",
        "img": "i-ice"
      },
      {
        "q": "~1 glass (200 ml)",
        "n": "Soda or chilled water",
        "tag": "soda",
        "alt": [
          "water"
        ],
        "img": "i-soda"
      }
    ],
    "steps": [
      {
        "t": "Dry roast cumin, coriander seeds, fennel seeds and black pepper in a pan. Stir until fragrant.",
        "imgs": [
          "s-roast-1",
          "s-roast-2",
          "s-roast-3"
        ]
      },
      {
        "t": "Tip the roasted spices into the mixie jar.",
        "imgs": [
          "s-jar-1"
        ]
      },
      {
        "t": "Add dry ginger powder, black salt and cardamom.",
        "imgs": [
          "s-add-1",
          "s-add-2"
        ]
      },
      {
        "t": "Add the rock sugar (mishri).",
        "imgs": [
          "s-mishri-1",
          "s-mishri-2"
        ]
      },
      {
        "t": "Grind everything to a fine powder.",
        "imgs": [
          "s-powder-1"
        ]
      },
      {
        "t": "Store the masala in a dry jar with a lid. It makes many glasses.",
        "imgs": [
          "s-store-1",
          "s-store-2"
        ]
      },
      {
        "t": "Put 5 to 6 mint leaves in a glass.",
        "imgs": [
          "s-mint-1",
          "s-mint-2"
        ]
      },
      {
        "t": "Add 1 spoon of the shikanji masala.",
        "imgs": [
          "s-masala-1",
          "s-masala-2"
        ]
      },
      {
        "t": "Pour in the lemon juice.",
        "imgs": [
          "s-lemon-1",
          "s-lemon-2"
        ]
      },
      {
        "t": "Swirl the glass so the masala mixes with the juice.",
        "imgs": [
          "s-swirl-1"
        ]
      },
      {
        "t": "Add ice cubes.",
        "imgs": [
          "s-ice-1"
        ]
      },
      {
        "t": "Top up with soda or chilled water.",
        "imgs": [
          "s-soda-1",
          "s-soda-2"
        ]
      },
      {
        "t": "Stir well with a straw.",
        "imgs": [
          "s-stir-1"
        ]
      },
      {
        "t": "Garnish with a mint sprig and a lemon slice.",
        "imgs": [
          "s-garnish-1"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender"
    ],
    "notes": "No speech and no amounts on screen, so all quantities are my estimates from the spoon and bowl sizes. The masala makes about 10 glasses; the last 4 ingredients are for one glass. Text shows cumin twice (roast, then in the mixie jar): I list it once. Black pepper amount is a guess; it is hard to see in the pan. Soda gives a fizzy drink, chilled water works too."
  },
