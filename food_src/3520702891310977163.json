      },
      {
        "t": "Pour the batter into a cake tin.",
        "imgs": [
          "s-tin-1",
          "s-tin-2"
        ]
      },
      {
        "t": "Sprinkle chopped walnuts on top.",
        "imgs": [
          "s-top-1",
          "s-top-2",
          "s-top-3"
