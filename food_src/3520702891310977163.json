          "s-butter-2",
          "s-butter-3"
        ]
      },
      {
        "t": "In another bowl, mix the ragi flour and whole wheat flour with baking powder and soda.",
        "imgs": [
          "s-dry-1",
          "s-dry-2"
        ]
      },
      {
        "t": "Add the flour mix to the date mix.",
        "imgs": [
          "s-add-1",
          "s-add-2",
          "s-add-3"
        ]
      },
      {
        "t": "Whisk into a smooth, thick batter.",
        "imgs": [
