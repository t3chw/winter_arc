          "s-jar-1",
          "s-jar-2"
        ]
      },
      {
        "t": "Blend until smooth.",
        "imgs": [
          "s-blend-1",
          "s-blend-2"
        ]
      },
      {
        "t": "Pour the date mix into a bowl.",
        "imgs": [
