    "cover": "cover",
    "ingredients": [
      {
        "q": "~1 cup (~150 g)",
        "n": "Pitted dates (khajoor)",
        "tag": "dates",
        "img": "i-dates"
      },
      {
        "q": "~1 cup (240 ml), warm",
        "n": "Milk",
        "tag": "milk",
        "img": "i-milk"
      },
      {
        "q": "~1/4 cup (~50 g), melted",
