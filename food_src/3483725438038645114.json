  "cover": "cover",
  "ingredients": [
   {
    "q": "~1/2 small head (300 g)",
    "n": "Cabbage (patta gobhi)",
    "tag": "cabbage",
    "img": "i-cabbage"
   },
   {
    "q": "1 medium",
    "n": "Red apple",
    "tag": "apple",
    "img": "i-apple"
   },
   {
    "q": "~3/4 tsp (1/2 tsp in apple water, a pinch in curd)",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "1 medium",
    "n": "Carrot",
    "tag": "carrot",
    "img": "i-carrot"
   },
   {
    "q": "1 small",
    "n": "Cucumber",
    "tag": "cucumber",
    "img": "i-cucumber"
   },
   {
    "q": "1 medium",
    "n": "Red onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~3/4 cup (150 g), thick",
    "n": "Curd (dahi)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~1 tbsp",
    "n": "Oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1 tsp",
    "n": "Mustard seeds (rai)",
    "tag": "mustard-seeds",
    "img": "i-mustard"
   },
   {
    "q": "~2",
    "n": "Dried red chillies",
    "tag": "dried-red-chilli",
    "img": "i-dchilli"
   },
   {
    "q": "~1 tsp",
    "n": "Urad dal (split, white)",
    "tag": "urad-dal",
    "alt": [
     "chana-dal"
    ],
    "img": "i-urad"
   },
   {
    "q": "~2",
    "n": "Green chillies, slit",
    "tag": "green-chilli",
    "img": "i-greenchilli"
   },
   {
    "q": "~10 leaves",
    "n": "Curry leaves",
    "tag": "curry-leaves",
    "img": "i-curryleaf"
   }
  ],
  "steps": [
   {
    "t": "Cut the cabbage in half.",
    "imgs": [
     "s-cab-1",
     "s-cab-2"
    ]
   },
   {
    "t": "Shred the cabbage thin.",
    "imgs": [
     "s-shred-1",
     "s-shred-2"
    ]
   },
   {
    "t": "Put the shredded cabbage in a bowl of cold water. Swish it around.",
    "imgs": [
     "s-soak-1",
     "s-soak-2"
    ]
   },
   {
    "t": "Lift it out and drain it in a strainer lined with kitchen paper.",
    "imgs": [
     "s-drain"
    ]
   },
   {
    "t": "Cover it with a lid and set it aside.",
    "imgs": [
     "s-lid"
    ]
   },
   {
    "t": "Cut the apple into thin slices, then into thin sticks.",
    "imgs": [
     "s-apple-1",
     "s-apple-2"
    ]
   },
   {
    "t": "Add a spoon of salt to a bowl of water. Put the apple sticks in.",
    "imgs": [
     "s-asoak-1",
     "s-asoak-2"
    ]
   },
   {
    "t": "Peel the carrot into thin strands.",
    "imgs": [
     "s-carrot-1",
     "s-carrot-2"
    ]
   },
   {
    "t": "Chop the cucumber into small pieces.",
    "imgs": [
     "s-cuc-1",
     "s-cuc-2"
    ]
   },
   {
    "t": "Slice the red onion thin.",
    "imgs": [
     "s-onion"
    ]
   },
   {
    "t": "Pour the curd into a big bowl and sprinkle a pinch of salt.",
    "imgs": [
     "s-curd-1",
     "s-curd-2",
     "s-curd-3"
    ]
   },
   {
    "t": "Whisk the curd until smooth and creamy.",
    "imgs": [
     "s-whisk"
    ]
   },
   {
    "t": "Layer the cabbage, carrot, onion, cucumber and drained apple on the curd.",
    "imgs": [
     "s-layer-1",
     "s-layer-2",
     "s-layer-3"
    ]
   },
   {
    "t": "Heat the oil in a pan on the gas.",
    "imgs": [
     "s-oil"
    ]
   },
   {
    "t": "Add the mustard seeds. Let them pop.",
    "imgs": [
     "s-mustard-1",
     "s-mustard-2"
    ]
   },
   {
    "t": "Add the dried red chillies and urad dal.",
    "imgs": [
     "s-dal"
    ]
   },
   {
    "t": "Add the slit green chillies and curry leaves.",
    "imgs": [
     "s-green-1",
     "s-green-2"
    ]
   },
   {
    "t": "Stir for a few seconds.",
    "imgs": [
     "s-stir"
    ]
   },
   {
    "t": "Pour the hot tadka over the salad.",
    "imgs": [
     "s-pour-1",
     "s-pour-2"
    ]
   },
   {
    "t": "Toss everything well until coated with curd.",
    "imgs": [
     "s-toss-1",
     "s-toss-2"
    ]
   },
   {
    "t": "Pile it on a plate and serve.",
    "imgs": [
     "s-plate-1",
     "s-plate-2",
     "s-plate-3"
    ]
   }
  ],
  "tags": [
   "gas",
   "high-fibre"
  ],
  "notes": "No speech or on-screen amounts (only the title 'Tadka salad'): all amounts are guesses. White spoon of powder in the apple water looks like salt; I assumed it is there to stop browning. Pale lentils in the tadka look like split urad dal (could be chana dal). Mix is mostly cabbage, so protein is low (about 5 g per serving). No creator name on screen."
