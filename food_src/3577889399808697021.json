  "dish": {
    "id": "aloo-suji-pancake",
    "name": "Aloo suji pancakes",
    "meal": "Breakfast",
    "minutes": 25,
    "protein": 10,
    "how": "Gas",
    "tools": "Blender (mixie), tawa, small pan, gas",
    "serves": 3,
    "cover": "cover",
    "ingredients": [
      {
        "q": "2 medium (~300 g)",
        "n": "Potato",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "40 g (~3 tbsp)",
        "n": "Curd",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "90 g (~1/2 cup)",
        "n": "Semolina (suji)",
        "tag": "suji",
        "img": "i-suji"
      },
      {
        "q": "2 tbsp",
        "n": "Gram flour (besan)",
        "tag": "besan",
        "img": "i-besan"
      },
      {
        "q": "1 tsp",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "200 ml (+ a splash)",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "1 medium",
        "n": "Onion, chopped",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "2 medium",
        "n": "Carrot, finely chopped",
        "tag": "carrot",
        "img": "i-carrot"
      },
      {
        "q": "1 medium",
        "n": "Capsicum, chopped",
        "tag": "capsicum",
        "img": "i-capsicum"
      },
      {
        "q": "1 medium",
        "n": "Tomato, chopped",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~2 tbsp",
        "n": "Coriander leaves, chopped",
        "tag": "coriander-leaves",
        "img": "i-coriander-leaves"
      },
      {
        "q": "2 tbsp (+ a little for the tawa)",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "1 tsp",
        "n": "Cumin seeds",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "1 tsp",
        "n": "Mustard seeds",
        "tag": "mustard-seeds",
        "img": "i-mustard-seeds"
      },
      {
        "q": "1/2 tsp",
        "n": "Hing (asafoetida)",
        "tag": "hing",
        "img": "i-hing"
      },
      {
        "q": "2 to 3 sprigs",
        "n": "Curry leaves",
        "tag": "curry-leaves",
        "img": "i-curry-leaves"
      },
      {
        "q": "1/2 tsp",
        "n": "Chilli flakes",
        "tag": "chilli-flakes",
        "img": "i-chilli-flakes"
      }
    ],
    "steps": [
      {
        "t": "Dice 2 potatoes and put them in the blender jar.",
        "imgs": [
          "s1-1",
          "s1-2"
        ]
      },
      {
        "t": "Add a splash of water, close the lid and blend to a thick paste.",
        "imgs": [
          "s2-1",
          "s2-2",
          "s2-3"
        ]
      },
      {
        "t": "Add 40 g curd and 90 g semolina to the jar.",
        "imgs": [
          "s3-1",
          "s3-2",
          "s3-3"
        ]
      },
      {
        "t": "Add 2 tbsp besan and 1 tsp salt.",
        "imgs": [
          "s4-1",
          "s4-2"
        ]
      },
      {
        "t": "Pour in 200 ml water.",
        "imgs": [
          "s5-1"
        ]
      },
      {
        "t": "Close the lid and blend again until smooth.",
        "imgs": [
          "s6-1",
          "s6-2"
        ]
      },
      {
        "t": "Pour the batter into a big bowl.",
        "imgs": [
          "s7-1",
          "s7-2"
        ]
      },
      {
        "t": "Add chopped onion, carrot and capsicum.",
        "imgs": [
          "s8-1",
          "s8-2",
          "s8-3"
        ]
      },
      {
        "t": "Add chopped tomato and coriander. Mix well.",
        "imgs": [
          "s9-1",
          "s9-2",
          "s9-3"
        ]
      },
      {
        "t": "Tadka: heat 2 tbsp oil in a small pan. Add cumin and mustard seeds.",
        "imgs": [
          "s10-1",
          "s10-2",
          "s10-3"
        ]
      },
      {
        "t": "Add hing, curry leaves and chilli flakes.",
        "imgs": [
          "s11-1",
          "s11-2",
          "s11-3"
        ]
      },
      {
        "t": "Pour the hot tadka over the batter and mix.",
        "imgs": [
          "s12-1",
          "s12-2"
        ]
      },
      {
        "t": "Heat a tawa. Wipe it with a little oil on a tissue.",
        "imgs": [
          "s13-1",
          "s13-2"
        ]
      },
      {
        "t": "Pour a ladle of batter on the tawa and spread it a little.",
        "imgs": [
          "s14-1",
          "s14-2"
        ]
      },
      {
        "t": "Cook until golden underneath. Flip and cook the other side.",
        "imgs": [
          "s15-1",
          "s15-2",
          "s15-3"
        ]
      },
      {
        "t": "Stack the pancakes and serve hot.",
        "imgs": [
          "s16-1",
          "s16-2",
          "s16-3"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender"
    ],
    "credit": "New Taste of India",
    "notes": "Video says 15 minutes; I allowed 25 for cooking all pancakes. Heat level and cooking time per side are not shown (the flip is only partly visible). Potato blend: the voiceover mentions a little water, no amount shown. About 6 pancakes in the video (serves 3 is my guess); low in protein."
