    "img": "i-atta"
   },
   {
    "q": "½ tsp",
    "n": "Baking powder",
    "tag": "baking-powder",
    "img": "i-baking-powder"
   },
   {
    "q": "½ tsp",
    "n": "Baking soda",
    "tag": "baking-soda",
    "img": "i-baking-soda"
   },
   {
    "q": "1 pinch",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~¼ cup (60 ml)",
    "n": "Refined oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1 tsp",
    "n": "Vanilla essence",
