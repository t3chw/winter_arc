  "dish": {
    "id": "white-paneer-curd-gravy",
    "name": "White paneer curd gravy",
    "meal": "Lunch or dinner",
    "minutes": 40,
    "protein": 15,
    "how": "Gas",
    "tools": "Pan, mixie, big bowl, whisk, steel spoon, spatula, knife, lid",
    "serves": 3,
    "cover": "cover",
    "ingredients": [
      {
        "q": "2 medium, cut in big pieces",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~3",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "~8 cloves",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~1 inch piece, in 2 to 3 bits",
        "n": "Ginger",
        "tag": "ginger",
        "img": "i-ginger"
      },
      {
        "q": "~1/4 cup (about 30 g)",
        "n": "Cashews (kaju)",
        "tag": "cashews",
        "img": "i-cashew"
      },
      {
        "q": "~6 whole for boiling, ~1/2 tsp powder for the curd",
        "n": "Black pepper (kali mirch)",
        "tag": "black-pepper",
        "img": "i-pepper"
      },
      {
        "q": "200 g, in small cubes",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~1 cup (about 200 g), fresh",
        "n": "Curd (dahi)",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "~3 tbsp",
        "n": "Fresh cream (malai)",
        "tag": "cream",
        "img": "i-cream"
      },
      {
        "q": "~1 tsp",
        "n": "Coriander powder",
        "tag": "coriander-powder",
        "img": "i-cpow",
        "alt": [
          "cumin-powder"
        ]
      },
      {
        "q": "~1 tsp",
        "n": "Turmeric powder (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1 tbsp",
        "n": "Ghee",
        "tag": "ghee",
        "img": "i-ghee"
      },
      {
        "q": "~1 tbsp",
        "n": "Butter",
        "tag": "butter",
        "img": "i-butter"
      },
      {
        "q": "1 small stick",
        "n": "Cinnamon (dalchini)",
        "tag": "cinnamon",
        "img": "i-cinnamon"
      },
      {
        "q": "~3 pods",
        "n": "Green cardamom (choti elaichi)",
        "tag": "cardamom",
        "img": "i-cardamom"
      },
      {
        "q": "2",
        "n": "Bay leaves (tej patta)",
        "tag": "bay-leaf",
        "img": "i-bay"
      },
      {
        "q": "~1 tsp, or to taste",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~1 tsp",
        "n": "Dried fenugreek leaves (kasuri methi)",
        "tag": "kasuri-methi",
        "img": "i-kasuri"
      },
      {
        "q": "a small handful, chopped",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "to serve",
        "n": "Roti",
        "tag": "atta",
        "img": "i-roti",
        "opt": true
      }
    ],
    "tags": [
      "gas",
      "blender"
    ],
    "notes": "The video has no text, so every amount is my estimate. Paneer is cut as fresh, not fried. The grey powder looks like black pepper powder and the brown one like coriander powder (it could be cumin or garam masala). Boiling time and flame levels are not shown or clear. The blending and the cooking times in the pan are not shown. The pink-white spoon at the salt step looks like pink salt. The creator's name is not on screen.",
    "steps": [
      {
