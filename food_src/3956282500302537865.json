  ],
  "dish": {
    "id": "aloo-corn-paneer-kachori",
    "name": "Aloo corn paneer kachori",
    "meal": "Snack",
    "minutes": 60,
    "protein": 15,
    "how": "Gas",
    "tools": "Non-stick pan, kadai, rolling pin, gas",
    "serves": 4,
    "cover": "cover",
    "ingredients": [
      {
        "q": "~2 tbsp for filling + ~4 tbsp for dough, plus oil for deep frying",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~1 tsp",
        "n": "Fennel seeds (saunf)",
        "tag": "fennel-seeds",
        "img": "i-fennel"
      },
      {
        "q": "~3, chopped",
        "n": "Green chilli",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "~1 tbsp, grated",
        "n": "Ginger",
        "tag": "ginger",
        "img": "i-ginger"
      },
      {
        "q": "~1 cup (150 g)",
        "n": "Sweet corn",
        "tag": "corn",
        "img": "i-corn"
      },
      {
        "q": "~1 cup (150 g)",
        "n": "Green peas",
        "tag": "peas",
        "img": "i-peas"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder",
        "tag": "red-chilli-powder",
        "img": "i-chilli-powder"
      },
      {
        "q": "~1 tsp",
        "n": "Coriander powder (dhania)",
        "tag": "coriander-powder",
        "img": "i-coriander-powder"
      },
      {
        "q": "~1/2 tsp",
        "n": "Turmeric (haldi)",
        "tag": "turmeric",
        "img": "i-turmeric"
      },
      {
        "q": "~1 tsp",
        "n": "Garam masala",
        "tag": "garam-masala",
        "img": "i-garam-masala"
      },
      {
        "q": "~1 tsp for filling + ~1/2 tsp for dough",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "~3 medium (300 g), boiled and mashed",
        "n": "Potato (aloo)",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~100 g, diced",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "~2 cups (250 g)",
        "n": "Refined flour (maida)",
        "tag": "all-purpose-flour",
        "img": "i-flour"
      },
      {
        "q": "~1 tsp",
        "n": "Carom seeds (ajwain)",
        "tag": "ajwain",
        "img": "i-ajwain"
      },
      {
        "q": "~1 tsp",
        "n": "Nigella seeds (kalonji)",
        "tag": "nigella-seeds",
        "img": "i-kalonji"
      },
      {
        "q": "~1/2 cup, as needed",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "a small bowl",
        "n": "Tomato ketchup, to dip",
        "tag": "tomato-ketchup",
        "opt": true,
        "img": "i-ketchup"
      }
    ],
    "steps": [
      {
        "t": "Heat oil in a non-stick pan on the gas.",
        "imgs": [
          "s-oil-1"
        ]
      },
      {
        "t": "Add cumin seeds and fennel seeds. Let them crackle.",
        "imgs": [
          "s-seeds-1",
          "s-seeds-2"
        ]
      },
      {
        "t": "Add chopped green chilli and grated ginger. Stir.",
        "imgs": [
          "s-chilli-1",
          "s-chilli-2"
        ]
      },
      {
        "t": "Add the sweet corn and green peas.",
        "imgs": [
          "s-corn-1",
          "s-corn-2"
        ]
      },
      {
        "t": "Add red chilli powder, coriander powder, turmeric and garam masala.",
        "imgs": [
          "s-spice-1",
          "s-spice-2"
        ]
      },
      {
        "t": "Add salt and mix well.",
        "imgs": [
          "s-salt-1"
        ]
      },
      {
        "t": "Add the mashed boiled potatoes and mix.",
        "imgs": [
          "s-potato-1",
          "s-potato-2"
        ]
      },
      {
        "t": "Add the diced paneer and mix gently. Keep this filling aside.",
        "imgs": [
          "s-paneer-1",
          "s-paneer-2"
        ]
      },
      {
        "t": "In a big bowl, mix the flour with salt, ajwain and kalonji.",
        "imgs": [
          "s-flour-1",
          "s-flour-2"
        ]
      },
      {
        "t": "Add oil and rub it into the flour with your fingers.",
        "imgs": [
          "s-oilrub-1",
          "s-oilrub-2"
        ]
      },
      {
        "t": "Add water and knead into a firm dough.",
        "imgs": [
          "s-knead-1",
          "s-knead-2"
        ]
      },
      {
        "t": "Take a small ball of dough and roll it into a small disc.",
        "imgs": [
          "s-roll-1",
          "s-roll-2"
        ]
      },
      {
        "t": "Put a spoon of the filling in the centre.",
        "imgs": [
          "s-fill-1"
        ]
      },
      {
        "t": "Pinch the edges together to close it into a ball.",
        "imgs": [
          "s-seal-1",
          "s-seal-2"
        ]
      },
      {
        "t": "Press the ball flat in your palm.",
        "imgs": [
          "s-flat-1"
        ]
      },
      {
        "t": "Slide into oil and deep fry, turning, until golden brown.",
        "imgs": [
          "s-fry-1",
          "s-fry-2"
        ]
      },
      {
        "t": "Lift out onto a wire rack to drain.",
        "imgs": [
          "s-drain-1"
        ]
      },
      {
        "t": "Serve with ketchup.",
        "imgs": [
          "s-serve-1",
          "s-serve-2"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "credit": "Deeksha's recipes",
    "notes": "No amounts are given in the video, so every quantity is a guess (about 8 kachoris). Brown seeds in the dough look like ajwain; the grey-brown spice added to the filling may be cumin powder instead of garam masala. Deep fried and made with maida. Oil heat and frying time are not stated."
  },
