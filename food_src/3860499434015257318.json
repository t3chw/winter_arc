  "dish": {
    "id": "paneer-thecha-rice",
    "name": "Paneer thecha rice",
    "meal": "Lunch or dinner",
    "minutes": 20,
    "protein": 55,
    "how": "Gas",
    "tools": "Pan, gas, small mixie jar, wooden spatula",
    "serves": 1,
    "cover": "cover",
    "ingredients": [
      {
        "q": "2 tsp (1 tsp for the thecha, 1 tsp for the rice)",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp (1/2 tsp each time)",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~6 cloves",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~3",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-chilli"
      },
      {
        "q": "30 g, plus a few crushed for topping",
        "n": "Peanuts",
        "tag": "peanuts",
        "img": "i-peanuts"
      },
      {
        "q": "~1 big handful, plus a little chopped for topping",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "~3 tbsp",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "1 medium, sliced",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "~1 small, chopped",
        "n": "Capsicum",
        "tag": "capsicum",
        "img": "i-capsicum"
      },
      {
        "q": "200 g, low fat, cubed",
        "n": "Paneer",
        "tag": "paneer",
        "img": "i-paneer"
      },
      {
        "q": "to taste",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "250 g cooked (about 1.5 cups)",
        "n": "Rice, cooked",
        "tag": "rice",
        "img": "i-rice"
      },
      {
        "q": "~1/2 lemon",
        "n": "Lemon juice",
        "tag": "lemon",
        "img": "i-lemon",
        "opt": true
      }
    ],
    "steps": [
      {
        "t": "Put a pan on the gas and heat 1 tsp oil.",
        "imgs": [
          "s-oil-1",
          "s-oil-2"
        ]
      },
      {
        "t": "Add the cumin seeds, then the garlic cloves and green chillies.",
        "imgs": [
          "s-spice-1",
          "s-spice-2",
          "s-spice-3"
        ]
      },
      {
        "t": "Add the 30 g peanuts. Fry, stirring, until they turn brown.",
        "imgs": [
          "s-pnut-1",
          "s-pnut-2"
        ]
      },
      {
        "t": "Tip the fried mix into a small mixie jar. Add the coriander and a little water.",
        "imgs": [
          "s-jar-1",
          "s-jar-2",
          "s-jar-3"
        ]
      },
      {
        "t": "Blend to a coarse green paste. This is the thecha.",
        "imgs": [
          "s-blend-1",
          "s-blend-2"
        ]
      },
      {
        "t": "Heat 1 tsp oil in the same pan and add cumin seeds.",
        "imgs": [
          "s-oil2-1",
          "s-oil2-2"
        ]
      },
      {
        "t": "Add the sliced onion, chopped tomato and chopped capsicum.",
        "imgs": [
          "s-veg-1",
          "s-veg-2",
          "s-veg-3"
        ]
      },
      {
        "t": "Stir until the vegetables soften.",
        "imgs": [
          "s-stir-1",
          "s-stir-2"
        ]
      },
      {
        "t": "Add the thecha paste and mix well.",
        "imgs": [
          "s-thecha-1",
          "s-thecha-2"
        ]
      },
      {
        "t": "Add the paneer cubes and salt. Stir until the paneer is coated with paste.",
        "imgs": [
          "s-paneer-1",
          "s-paneer-2",
          "s-paneer-3"
        ]
      },
      {
        "t": "Add the cooked rice and mix until it turns green and even.",
        "imgs": [
          "s-rice-1",
          "s-rice-2",
          "s-rice-3"
        ]
      },
      {
        "t": "Sprinkle crushed peanuts and chopped coriander on top.",
        "imgs": [
          "s-top-1",
          "s-top-2"
        ]
      },
      {
        "t": "Squeeze a little lemon juice on top and serve.",
        "imgs": [
          "s-lemon-1",
          "s-lemon-2"
        ]
      }
    ],
    "tags": [
      "gas",
      "blender",
      "high-protein"
    ],
    "notes": "On screen: oil 1 tsp (twice), peanuts 30 g, paneer 200 g low fat, cooked rice 250 g. Garlic, chillies, cumin, coriander, water, onion, tomato, capsicum, lemon and the topping peanuts are my estimates (marked ~). No frying times or flame levels are shown or said. Video claims 63 g protein for the bowl; my ingredient estimate is about 55 g. Needs ready cooked rice. Blend step has no close-up of the finished paste; see the next step."
