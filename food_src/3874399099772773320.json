    "tools": "Mixie, mortar, pan, kadhai, slotted spoon, gas",
    "serves": 4,
    "cover": "cover",
    "ingredients": [
      {
        "q": "1 cup (about 120 g)",
        "n": "Maida (refined flour)",
        "tag": "all-purpose-flour",
