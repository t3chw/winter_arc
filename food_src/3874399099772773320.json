      },
      {
        "q": "1/2 tsp",
        "n": "Ajwain (carom seeds)",
        "tag": "ajwain",
        "img": "i-ajwain"
      },
      {
        "q": "1.5 tsp (1/2 tsp for dough, 1 tsp for filling)",
        "n": "Salt",
        "tag": "salt",
        "img": "i-salt"
      },
      {
        "q": "3 tbsp for dough, ~2 tbsp for filling, ~2 cups for frying",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1/4 cup, as needed",
        "n": "Water",
        "tag": "water",
        "img": "i-water"
      },
      {
        "q": "1 cup (about 200 g), soaked in water",
        "n": "Moong dal (split yellow)",
        "tag": "moong-dal",
        "img": "i-dal"
      },
      {
        "q": "1 to 2",
        "n": "Dry red chilli",
