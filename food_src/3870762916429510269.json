    "cover": "cover",
    "ingredients": [
      {
        "q": "~3 medium, boiled",
        "n": "Potatoes",
        "tag": "potato",
        "img": "i-potato"
      },
      {
        "q": "~1.5 tsp (1 tsp to roast, 1/2 tsp for tadka)",
        "n": "Cumin seeds (jeera)",
        "tag": "cumin",
        "img": "i-cumin"
      },
      {
        "q": "~1.5 cups (300 g), thick",
        "n": "Curd (dahi)",
        "tag": "curd",
        "img": "i-curd"
      },
      {
        "q": "1 medium, chopped",
        "n": "Onion",
        "tag": "onion",
        "img": "i-onion"
      },
      {
        "q": "~2, chopped",
        "n": "Green chillies",
        "tag": "green-chilli",
        "img": "i-green-chilli"
      },
      {
        "q": "1 medium, chopped",
        "n": "Tomato",
        "tag": "tomato",
        "img": "i-tomato"
      },
      {
        "q": "a big handful, chopped",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander"
      },
      {
        "q": "~1 tsp (from the roasted cumin)",
        "n": "Roasted cumin powder (bhuna jeera)",
        "tag": "cumin-powder",
        "img": "i-cumin-powder"
      },
      {
        "q": "~1/2 tsp",
        "n": "Black salt (kala namak)",
        "tag": "black-salt",
        "img": "i-black-salt"
      },
      {
        "q": "~1 tbsp",
        "n": "Oil",
        "tag": "oil",
        "img": "i-oil"
      },
      {
        "q": "~1 tsp",
        "n": "Red chilli powder (deggi mirch)",
        "tag": "red-chilli-powder",
        "img": "i-red-chilli"
      },
      {
        "q": "~1.5 cups (about 250 g), cooked",
        "n": "Rice",
        "tag": "rice",
        "img": "i-rice"
      }
    ],
