  "dish": {
    "id": "cheesy-veg-roti-garlic-bread",
    "name": "Cheesy veg roti garlic bread",
    "meal": "Snack",
    "minutes": 25,
    "protein": 10,
    "how": "Gas",
    "tools": "Tawa, spatula, spoons, bowls, gas",
    "serves": 2,
    "cover": "cover",
    "ingredients": [
      {
        "q": "2",
        "n": "Roti (chapati), ready-made",
        "tag": "atta",
        "img": "i-roti"
      },
      {
        "q": "~3 tbsp, soft",
        "n": "Butter",
        "tag": "butter",
        "img": "i-butter"
      },
      {
        "q": "~4 cloves, grated",
        "n": "Garlic",
        "tag": "garlic",
        "img": "i-garlic"
      },
      {
        "q": "~1 tsp (for the butter and the filling)",
        "n": "Chilli flakes",
        "tag": "chilli-flakes",
        "img": "i-chilli-flakes"
      },
      {
        "q": "~3 tbsp, chopped (for the butter and the filling)",
        "n": "Coriander leaves",
        "tag": "coriander-leaves",
        "img": "i-coriander-leaves"
      },
      {
        "q": "~1/2 cup, mixed colours, diced",
        "n": "Bell peppers (capsicum)",
        "tag": "capsicum",
        "img": "i-capsicum"
      },
      {
        "q": "~1/4 cup",
        "n": "Sweet corn",
        "tag": "corn",
        "img": "i-corn"
      },
      {
        "q": "~2 tbsp, chopped",
        "n": "Black olives",
        "tag": "olives",
        "img": "i-olives"
      },
      {
        "q": "~1 tbsp, chopped",
        "n": "Jalapeno (pickled)",
        "tag": "jalapeno",
        "img": "i-jalapeno"
      },
      {
        "q": "~1/2 cup, grated",
        "n": "Cheese",
        "tag": "cheese",
        "img": "i-cheese"
      },
      {
        "q": "~1/2 tsp",
        "n": "Mixed herbs (or oregano)",
        "tag": "oregano",
        "img": "i-oregano"
      },
      {
        "q": "to taste",
        "n": "Salt",
        "tag": "salt"
      },
      {
        "q": "~2 tbsp",
        "n": "Tomato ketchup or red chilli sauce",
        "tag": "tomato-ketchup",
        "img": "i-tomato-ketchup"
      }
    ],
    "steps": [
      {
        "t": "Put butter and grated garlic in a small bowl.",
        "imgs": [
          "s1-1",
          "s1-2"
        ]
      },
      {
        "t": "Add chilli flakes and chopped coriander.",
        "imgs": [
          "s2-1",
          "s2-2"
        ]
      },
      {
        "t": "Mix well into a garlic butter. Keep it aside.",
        "imgs": [
          "s3-1",
          "s3-2"
        ]
      },
      {
        "t": "Put diced bell peppers, corn, black olives and jalapeno in another bowl.",
        "imgs": [
          "s4-1",
          "s4-2",
          "s4-3"
        ]
      },
      {
        "t": "Add coriander, mixed herbs, chilli flakes and salt.",
        "imgs": [
          "s5-1",
          "s5-2",
          "s5-3"
        ]
      },
      {
        "t": "Add the grated cheese. Mix well.",
        "imgs": [
          "s6-1",
          "s6-2",
          "s6-3"
        ]
      },
      {
        "t": "Spread garlic butter on a roti.",
        "imgs": [
          "s7-1",
          "s7-2",
          "s7-3"
        ]
      },
      {
        "t": "Spread a little red sauce on top.",
        "imgs": [
          "s8-1",
          "s8-2",
          "s8-3"
        ]
      },
      {
        "t": "Spoon the veg and cheese filling over the roti.",
        "imgs": [
          "s9-1",
          "s9-2",
          "s9-3"
        ]
      },
      {
        "t": "Fold the roti in half.",
        "imgs": [
          "s10-1",
          "s10-2"
        ]
      },
      {
        "t": "Spread garlic butter on top of the folded roti.",
        "imgs": [
          "s11-1",
          "s11-2"
        ]
      },
      {
        "t": "Place on a hot tawa. Press gently.",
        "imgs": [
          "s12-1",
          "s12-2",
          "s12-3"
        ]
      },
      {
        "t": "Spread more garlic butter on top. Press with a spatula.",
        "imgs": [
          "s13-1",
          "s13-2",
          "s13-3"
        ]
      },
      {
        "t": "Flip. Cook until both sides are golden.",
        "imgs": [
          "s14-1",
          "s14-2",
          "s14-3"
        ]
      },
      {
        "t": "Cut into pieces. Serve hot.",
        "imgs": [
          "s15-1",
          "s15-2",
          "s15-3"
        ]
      }
    ],
    "tags": [
      "gas"
    ],
    "notes": "Silent video; the on-screen text lists only ingredient names, no amounts, so every quantity is my guess. Salt is listed but never shown. The red sauce looks like ketchup or a sweet chilli sauce. Pan fat is only the garlic butter (no oil shown). Heat level and cooking times are not shown. Cheese pull images are from the intro. Low-ish protein unless you add more cheese."
