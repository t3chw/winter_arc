  "name": "Paneer pizza toast",
  "meal": "Snack",
  "minutes": 15,
  "protein": 20,
  "how": "Gas",
  "tools": "Non-stick pan with lid, gas, plate, small steel bowl",
  "serves": 1,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1 tbsp",
    "n": "Tomato sauce (ketchup)",
    "tag": "tomato-ketchup",
    "img": "i-ketchup"
   },
   {
    "q": "~1 tbsp",
    "n": "Mayonnaise (check for the green dot on the pack)",
    "tag": "mayonnaise",
    "img": "i-mayo"
   },
   {
    "q": "~1 tbsp",
    "n": "Veg mayonnaise (the flavoured orange-brown one)",
    "tag": "mayonnaise",
    "img": "i-vegmayo"
   },
   {
    "q": "~1/2 tsp, plus a pinch for the top",
    "n": "Chilli flakes",
    "tag": "chilli-flakes",
    "img": "i-flakes"
   },
   {
    "q": "~1/2 tsp, plus a pinch for the top",
    "n": "Oregano",
    "tag": "oregano",
    "img": "i-oregano"
   },
   {
    "q": "~10 small cubes (60 g)",
    "n": "Paneer, cubed",
    "tag": "paneer",
    "img": "i-paneer"
   },
   {
    "q": "1 slice",
    "n": "Bread",
    "tag": "bread",
    "img": "i-bread"
   },
   {
    "q": "~1/3 cup (35 g)",
    "n": "Mozzarella cheese, grated",
    "tag": "cheese",
    "img": "i-cheese"
   },
   {
    "q": "~1 tsp",
    "n": "Butter",
    "tag": "butter",
    "img": "i-butter"
   }
  ],
  "steps": [
