 "dish": {
  "id": "crispy-ragi-veg-dosa",
  "name": "Crispy ragi veg dosa",
  "meal": "Breakfast",
  "minutes": 40,
  "protein": 5,
  "how": "Gas",
  "tools": "Tawa, gas, big bowl, sieve, whisk, ladle",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
   {
    "q": "~1 cup (~120 g)",
    "n": "Ragi flour (nachni atta)",
    "tag": "millet",
    "img": "i-ragi"
   },
   {
    "q": "~1 tsp",
    "n": "Ginger, grated",
    "tag": "ginger",
    "img": "i-ginger"
   },
   {
    "q": "~1 tsp",
    "n": "Cumin seeds (jeera)",
    "tag": "cumin",
    "img": "i-cumin"
   },
   {
    "q": "~10 leaves, chopped",
    "n": "Curry leaves",
    "tag": "curry-leaves",
    "img": "i-curry"
   },
   {
    "q": "~1, chopped",
    "n": "Green chilli",
    "tag": "green-chilli",
    "img": "i-chilli"
   },
   {
    "q": "~1/2 cup, grated",
    "n": "Carrot",
    "tag": "carrot",
    "img": "i-carrot"
   },
   {
    "q": "~1/2 cup, chopped",
    "n": "Onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~1 tsp",
    "n": "Salt",
    "tag": "salt"
   },
   {
    "q": "~3 cups (~700 ml)",
    "n": "Water",
    "tag": "water",
    "img": "i-water"
   },
   {
    "q": "~1/4 cup, chopped",
    "n": "Coriander leaves",
    "tag": "coriander-leaves",
    "img": "i-coriander"
   },
   {
    "q": "~1/2 tsp",
    "n": "Oil, to wipe the tawa",
    "tag": "oil"
   },
   {
    "q": "~2 tsp",
    "n": "Ghee, for the top",
    "tag": "ghee",
    "img": "i-ghee"
   }
  ],
  "steps": [
   {
    "t": "Sieve the ragi flour into a large bowl.",
    "imgs": [
     "s-sieve-1",
     "s-sieve-2"
    ]
   },
   {
    "t": "Add grated ginger, cumin seeds and chopped curry leaves.",
    "imgs": [
     "s-spice-1",
     "s-spice-2"
    ]
   },
   {
    "t": "Add chopped green chilli, grated carrot and chopped onion.",
    "imgs": [
     "s-veg-1",
     "s-veg-2",
     "s-veg-3"
    ]
   },
   {
    "t": "Sprinkle in the salt and mix everything with a spoon.",
    "imgs": [
     "s-salt-1",
     "s-salt-2"
    ]
   },
   {
    "t": "Pour in water a little at a time, whisking well after each pour.",
    "imgs": [
     "s-water-1",
     "s-water-2",
     "s-water-3"
    ]
   },
   {
    "t": "Keep adding water and whisking until the batter is thin and runny, with no lumps.",
    "imgs": [
     "s-thin-1",
     "s-thin-2",
     "s-thin-3"
    ]
   },
   {
    "t": "Cover the bowl with a plate and let the batter rest.",
    "imgs": [
     "s-cover-1",
     "s-cover-2"
    ]
   },
   {
    "t": "Take off the plate, add the chopped coriander and mix well with a ladle.",
    "imgs": [
     "s-corn-1",
     "s-corn-2",
     "s-corn-3"
    ]
   },
   {
    "t": "Stir the batter again just before cooking. It should pour thin, like water.",
    "imgs": [
     "s-stir-1"
    ]
   },
   {
    "t": "Heat the tawa on the gas and wipe it with a little oil.",
    "imgs": [
     "s-tawa-1",
     "s-tawa-2"
    ]
   },
   {
    "t": "Pour batter from the edge inwards, filling the gaps, to make a thin lacy dosa.",
    "imgs": [
     "s-pour-1",
     "s-pour-2",
     "s-pour-3"
    ]
   },
   {
    "t": "Drizzle ghee over the top.",
    "imgs": [
     "s-ghee-1",
     "s-ghee-2"
    ]
   },
   {
    "t": "Cook on a low flame for 7 to 8 minutes until crisp.",
    "imgs": [
     "s-cook-1"
    ]
   },
   {
    "t": "Lift the crisp dosa off the tawa with a spatula.",
    "imgs": [
     "s-lift-1",
     "s-lift-2"
    ]
   },
   {
    "t": "Serve hot with chutney.",
    "imgs": [
     "s-serve-1",
     "s-serve-2"
    ]
   }
  ],
  "tags": [
   "gas",
   "high-fibre"
  ],
  "notes": "Amounts are not shown or said (full list was only in the creator's comments), so all quantities are my estimates from the frames: check that the batter pours thin like water. Resting time after covering the bowl is not shown. The video flips straight from the pour to ghee to lifting, so I did not add a flip step. Chutney is shown but its recipe is not."
 },
