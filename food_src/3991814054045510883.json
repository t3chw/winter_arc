  "name": "Paneer tikka skewers",
  "meal": "Snack",
  "minutes": 90,
  "protein": 25,
  "how": "Gas",
  "tools": "Grill pan, skewers, mixing bowl, spatula, gas",
  "serves": 2,
  "cover": "cover",
  "ingredients": [
