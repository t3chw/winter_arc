   },
   {
    "q": "~3/4 cup (150 g), thick",
    "n": "Curd (hung curd)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~1/2 tsp, to taste",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~1/2 tsp",
    "n": "Turmeric powder",
    "tag": "turmeric",
    "img": "i-turmeric"
   },
   {
    "q": "~2 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chilli"
   },
   {
    "q": "~1 tsp",
    "n": "Coriander powder",
    "tag": "coriander-powder",
    "img": "i-coriander"
   },
   {
    "q": "~1 tsp",
    "n": "Cumin powder",
    "tag": "cumin-powder",
    "img": "i-cumin"
   },
   {
    "q": "~1 tsp",
    "n": "Garam masala",
    "tag": "garam-masala",
    "img": "i-garam"
   },
   {
    "q": "~1/2 tsp",
    "n": "Black pepper powder",
    "tag": "black-pepper",
    "img": "i-pepper"
   },
   {
    "q": "~1 tsp",
    "n": "Chaat masala",
    "tag": "chaat-masala",
    "img": "i-chaat"
   },
   {
    "q": "~1 tbsp",
    "n": "Ginger-garlic paste",
    "tag": "ginger",
    "alt": [
     "garlic"
    ],
    "img": "i-gg"
   },
   {
    "q": "~1/2 tsp",
    "n": "Carom seeds (ajwain)",
    "tag": "ajwain",
    "img": "i-ajwain"
   },
   {
    "q": "~1 tsp",
    "n": "Kasuri methi (dried fenugreek leaves)",
    "tag": "kasuri-methi",
    "img": "i-methi"
   },
   {
    "q": "~1 tbsp (juice of 1/2 lemon)",
    "n": "Lemon juice",
    "tag": "lemon",
    "img": "i-lemon"
   },
   {
    "q": "~2 tbsp",
    "n": "Roasted gram flour (besan)",
    "tag": "besan",
    "alt": [
     "sattu"
    ],
    "img": "i-besan"
   },
   {
    "q": "~1 tbsp, hot",
    "n": "Mustard oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1 medium, in chunks",
    "n": "Capsicum",
    "tag": "capsicum",
    "img": "i-capsicum"
   },
   {
    "q": "~1 medium, in petals",
    "n": "Onion",
    "tag": "onion",
    "img": "i-onion"
   },
   {
    "q": "~1 medium, in chunks",
    "n": "Tomato",
    "tag": "tomato",
    "img": "i-tomato"
   },
   {
    "q": "1 small bowl",
    "n": "Green chutney, to serve",
    "tag": "green-chutney",
    "opt": true,
    "img": "i-chutney"
   }
  ],
  "steps": [
   {
    "t": "Put the curd in a mixing bowl.",
    "imgs": [
     "s-curd-1"
    ]
   },
   {
    "t": "Add salt, turmeric and red chilli powder.",
    "imgs": [
     "s-spice1-1"
    ]
   },
   {
    "t": "Add coriander powder, cumin powder and garam masala.",
    "imgs": [
     "s-spice2-1"
    ]
   },
   {
    "t": "Add black pepper powder and chaat masala.",
    "imgs": [
     "s-spice3-1"
    ]
   },
   {
    "t": "Add ginger-garlic paste and carom seeds.",
    "imgs": [
     "s-paste-1"
    ]
   },
   {
    "t": "Add kasuri methi and lemon juice.",
    "imgs": [
     "s-methi-1"
    ]
   },
   {
    "t": "Add the roasted gram flour.",
    "imgs": [
     "s-besan-1"
    ]
   },
   {
    "t": "Pour in the hot mustard oil.",
    "imgs": [
     "s-oil-1"
    ]
   },
   {
    "t": "Mix everything well into a smooth marinade.",
    "imgs": [
     "s-mix-1"
    ]
   },
   {
    "t": "Add the capsicum, onion and tomato chunks.",
    "imgs": [
     "s-veg-1"
    ]
   },
   {
    "t": "Coat the vegetables well in the marinade.",
    "imgs": [
     "s-coat-1"
    ]
   },
   {
    "t": "Add the paneer cubes.",
    "imgs": [
     "s-paneer-1"
    ]
   },
   {
    "t": "Coat the paneer gently so the cubes do not break.",
    "imgs": [
     "s-gentle-1"
    ]
   },
   {
    "t": "Rest it for 1 hour.",
    "imgs": [
     "s-rest-1"
    ]
   },
   {
    "t": "Thread paneer, capsicum, onion and tomato onto skewers.",
    "imgs": [
     "s-thread-1",
     "s-thread-2"
    ]
   },
   {
    "t": "Place the skewers on a hot grill pan.",
    "imgs": [
     "s-place-1"
    ]
   },
   {
    "t": "Grill on a medium flame.",
    "imgs": [
     "s-grill-1"
    ]
   },
   {
    "t": "Turn the skewers around so they grill evenly on all sides.",
    "imgs": [
     "s-turn-1",
     "s-turn-2"
    ]
   },
   {
    "t": "Serve the paneer tikka hot.",
    "imgs": [
     "s-serve-1"
    ]
   }
  ],
  "tags": [
   "gas",
   "high-protein"
  ],
  "notes": "On-screen captions name every ingredient and step but give no amounts: all amounts are estimates (~). Grilling time is not shown (about 10 to 15 minutes in the pan is my guess). Includes 1 hour resting time. Mustard oil can be swapped with any oil."
