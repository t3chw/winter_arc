    "n": "Oil",
    "tag": "oil",
    "img": "i-oil"
   },
   {
    "q": "~1/2 tsp",
    "n": "Cumin seeds (jeera)",
    "tag": "cumin",
    "img": "i-cumin"
   },
   {
    "q": "~8 leaves",
    "n": "Curry leaves",
    "tag": "curry-leaves",
    "img": "i-curryleaf"
   },
   {
    "q": "~1",
    "n": "Green chilli, chopped",
    "tag": "green-chilli",
    "img": "i-greenchilli"
   },
   {
    "q": "~4 cloves",
    "n": "Garlic, chopped",
    "tag": "garlic",
    "img": "i-garlic"
   },
   {
    "q": "~1/4 tsp",
    "n": "Turmeric (haldi)",
    "tag": "turmeric",
    "img": "i-turmeric"
   },
   {
    "q": "~1 tsp",
    "n": "Red chilli powder",
    "tag": "red-chilli-powder",
    "img": "i-chillipowder"
   },
   {
    "q": "~1/2 tsp",
    "n": "Coriander powder (dhania)",
    "tag": "coriander-powder",
    "img": "i-corpowder"
   },
   {
    "q": "~1/2 cup (100 g)",
    "n": "Curd (dahi)",
    "tag": "curd",
    "img": "i-curd"
   },
   {
    "q": "~1/2 tsp",
    "n": "Salt",
    "tag": "salt",
    "img": "i-salt"
   },
   {
    "q": "~2 tbsp",
    "n": "Coriander leaves, chopped",
    "tag": "coriander-leaves",
    "img": "i-corleaf"
   },
   {
    "q": "~3/4 cup (120 g), boiled",
    "n": "Black chana (kala chana)",
    "tag": "kala-chana",
    "img": "i-chana"
   },
   {
    "q": "~75 g",
    "n": "Paneer or tofu, cut in strips and pan-cooked",
    "tag": "paneer",
    "alt": [
     "tofu"
    ],
    "img": "i-paneer"
   },
   {
    "q": "~1/2 tsp",
    "n": "Chaat masala",
    "tag": "chaat-masala",
    "img": "i-masala"
   },
   {
    "q": "~1/2",
    "n": "Lemon",
    "tag": "lemon",
    "img": "i-lemon"
   }
  ],
  "steps": [
   {
    "t": "Peel the carrot. Cut it into thin sticks.",
    "imgs": [
     "s-carrot-1",
     "s-carrot-2"
    ]
   },
   {
    "t": "Cut the tomato, peeled cucumber and red onion into thin slices.",
    "imgs": [
     "s-veg-1",
     "s-veg-2",
     "s-veg-3"
    ]
   },
   {
    "t": "Heat about 1 tsp oil in a small pan on the gas.",
    "imgs": [
     "s-oil"
    ]
   },
   {
    "t": "Add cumin seeds, curry leaves and chopped green chilli. Let them sizzle.",
    "imgs": [
     "s-seeds-1",
     "s-seeds-2",
     "s-seeds-3"
    ]
   },
   {
    "t": "Add chopped garlic. Stir until it turns light golden.",
    "imgs": [
     "s-garlic-1",
     "s-garlic-2"
    ]
   },
   {
    "t": "Add turmeric, red chilli powder and coriander powder.",
    "imgs": [
     "s-spice-1",
     "s-spice-2",
     "s-spice-3"
    ]
   },
   {
    "t": "Pour the hot tadka over the curd in a bowl.",
    "imgs": [
     "s-curd-1"
    ]
   },
   {
    "t": "Add salt and chopped coriander. Mix until smooth.",
    "imgs": [
     "s-curd-2",
     "s-curd-3",
     "s-curd-4"
    ]
   },
   {
    "t": "In a big bowl, put the boiled kala chana, then the carrot and onion.",
    "imgs": [
     "s-bowl-1",
     "s-bowl-2"
    ]
   },
   {
    "t": "Add the cucumber, tomato and the pan-cooked paneer strips.",
    "imgs": [
     "s-paneer-1",
     "s-paneer-2"
    ]
   },
   {
    "t": "Sprinkle chaat masala, red chilli powder and coriander leaves. Squeeze lemon over it.",
    "imgs": [
     "s-season-1",
     "s-season-2",
     "s-season-3"
    ]
   },
   {
    "t": "Toss everything well with your hand.",
    "imgs": [
     "s-toss-1",
     "s-toss-2"
    ]
   },
   {
    "t": "Pour the spiced curd into a wide bowl.",
    "imgs": [
     "s-pour"
    ]
   },
   {
    "t": "Heap the salad on the curd and serve.",
    "imgs": [
     "s-plate-1",
     "s-plate-2"
    ]
   }
  ],
  "tags": [
   "gas",
   "high-protein",
   "high-fibre"
  ],
  "credit": "Oh,Cheat Day!",
  "notes": "No amounts in the video (recipe was in the caption): all amounts are guesses. Boiled chana and the pan-cooked paneer/tofu are shown ready, not cooked. Pink powder = salt (could be black salt); brown powder in step 11 looks like chaat masala."
 },
